{
  "meta": {
    "name": "bulkhead-sh",
    "description": "linux-host-compat (nono's own), plus the runtimes and git config the harness packs add, a writable workspace, and read-only bash startup files, for compart sh (see compartments.md)"
  },
  "extends": "linux-host-compat",
  "groups": {
    "include": [
      "git_config",
      "node_runtime",
      "python_runtime",
      "rust_runtime",
      "unlink_protection",
      "user_caches_linux"
    ]
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "read": [
      "/etc/profile.d",
      "/etc/bash_completion.d"
    ],
    "read_file": [
      "/etc/bash.bashrc",
      "/etc/profile",
      "/etc/bash_completion",
      "$HOME/.bashrc",
      "$HOME/.profile",
      "$HOME/.bash_logout",
      "$HOME/.bash_aliases",
      "$HOME/.inputrc",
      "$HOME/.dircolors",
      "$HOME/.config/environment.d/50-bulkhead-git-safety.conf"
    ],
    "bypass_protection": [
      "$HOME/.bashrc",
      "$HOME/.profile",
      "$HOME/.bash_logout"
    ],
    "unix_socket": [
      "$XDG_RUNTIME_DIR/speech-dispatcher/speechd.sock",
      "/run/nscd/socket"
    ],
    "allow": [
      "/dev/shm"
    ],
    "unix_socket_subtree_bind": [
      "$WORKDIR",
      "$TMPDIR",
      "/tmp"
    ]
  },
  "linux": {
    "af_unix_mediation": "pathname"
  }
}
