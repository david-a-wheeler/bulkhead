#!/bin/sh
# bulkhead-workspace: find a directory's workspace (see compartments.md),
# refuse a directory no agent should start in, and set up the
# workspace's dossier. Every bulkhead script asks this, so they all
# agree. Run it outside every sandbox.
#
# Usage: bulkhead-workspace key|root|dossier [DIR]
#        bulkhead-workspace prepare [--yes] [DIR]
#        bulkhead-workspace orphans
# DIR defaults to the current directory.
#   key       print the workspace's name: projects-NAME, sensitive-NAME,
#             or dir%PATH (its path with "/" as "%")
#   root      print the workspace's top directory
#   dossier   print its dossier: data about the workspace that its agent
#             mustn't fully control, or that mustn't arrive with the
#             workspace's contents
#   prepare   create or update the dossier, then print its path. Safe to
#             re-run. compart and anon-access run this before anything
#             else: nono binds grants at start, so a directory made
#             later stays denied. Outside ~/projects and ~/sensitive,
#             it asks you (on the terminal) before creating a dossier,
#             unless you give --yes; with no terminal, it refuses.
#   orphans   print each dossier whose workspace is gone (moved or
#             deleted without it)
#
# The workspace is ~/projects/NAME or ~/sensitive/NAME when DIR's real
# path is in one of them, with its dossier beside it (NAME.dossier).
# Else it's DIR itself, with its dossier in
# ~/.local/state/bulkhead/dossiers/KEY, where no workspace can hold it.
# The dossier holds state/ (the harness's private files, which
# bulkhead-compartment binds over ~/.claude and the like), logs/ (e.g.,
# nono's log; no agent access), policy/ (local-ports and expose-ports),
# git/ (the git settings you've approved; see bulkhead-git-check),
# snapshots/ (made by bulkhead-snapshot), inbox/, outbox/, and
# workspace (the path it was made for).
#
# Every command but orphans refuses (exits 1, saying why) DIR when DIR
# or its workspace matches a pattern in workspace-forbidden
# ($BULKHEAD_WORKSPACE_FORBIDDEN, else the installed copy), or when the
# workspace is ~ or above it (an agent there would be granted every
# workspace's dossier). prepare also fails if you can't write the
# workspace or create its dossier, or if the dossier isn't yours.
set -eu

usage() {
  echo "Usage: bulkhead-workspace key|root|dossier|prepare [--yes] [DIR], or orphans" >&2
  exit 2
}
say() {
  echo "bulkhead: $*" >&2
}
[ "$#" -ge 1 ] || usage
cmd="$1"
shift
yes=false
if [ "$cmd" = prepare ] && [ "${1:-}" = --yes ]; then
  yes=true
  shift
fi
[ "$#" -le 1 ] || usage
here="$(cd "${1:-.}" && pwd -P)"
home="$(cd "$HOME" && pwd -P)"
# Not $XDG_STATE_HOME: nono-claude-profile.json grants one directory
# under ~/.local/state/bulkhead, and this must stay outside it.
central="$home/.local/state/bulkhead/dossiers"
make_central() {
  mkdir -p "$(dirname "$central")"
  [ -d "$central" ] || mkdir -m 700 "$central"
}

# TRANSITIONAL: remove once every VM has run this. Dossiers outside
# ~/projects and ~/sensitive used to sit beside their workspaces, listed
# in a registry. Move each into $central, all at once, since a
# workspace could hold another's old dossier; then the registry goes.
registry="$home/.local/state/bulkhead/workspaces"
if [ -f "$registry" ]; then
  while IFS= read -r ws; do
    case "$ws/" in
      "$home"/projects/?*/* | "$home"/sensitive/?*/* | /) continue ;;
    esac
    old="$ws.dossier"
    new="$central/dir$(printf '%s' "$ws" | tr '/' '%')"
    [ -d "$old" ] && [ ! -L "$old" ] || continue
    if [ -e "$new" ]; then
      say "WARNING: didn't move $old to $new, which exists; look them over."
      continue
    fi
    make_central
    mv "$old" "$new"
    say "moved $old to $new (see compartments.md)."
  done < "$registry"
  rm -f "$registry"
fi

case "$cmd" in
  orphans)
    for d in "$home"/projects/*.dossier "$home"/sensitive/*.dossier; do
      [ ! -d "$d" ] || [ -d "${d%.dossier}" ] || printf '%s\n' "$d"
    done
    for d in "$central"/*; do
      [ -d "$d" ] || continue
      ws="$(cat "$d/workspace" 2> /dev/null || :)"
      [ -n "$ws" ] && [ -d "$ws" ] || printf '%s\n' "$d"
    done
    exit 0
    ;;
  key | root | dossier | prepare) ;;
  *) usage ;;
esac
forbidden="${BULKHEAD_WORKSPACE_FORBIDDEN:-/usr/local/libexec/bulkhead/workspace-forbidden}"

refuse() {
  say "no agent may start in $here: $1"
  exit 1
}

case "$here/" in
  "$home"/projects/?*/* | "$home"/sensitive/?*/*)
    rest="${here#"$home"/}"
    top="${rest%%/*}"
    rest="${rest#*/}"
    key="$top-${rest%%/*}"
    root="$home/$top/${rest%%/*}"
    dossier="$root.dossier"
    beside=true
    ;;
  *)
    root="$here"
    # "/" becomes "%" so the key is one path component.
    key="dir$(printf '%s' "$root" | tr '/' '%')"
    dossier="$central/$key"
    beside=false
    ;;
esac

case "$home/" in
  "${root%/}"/*) refuse "$root holds your home directory, so an agent there could change every workspace's dossier." ;;
esac
[ -r "$forbidden" ] || {
  say "can't read $forbidden, so can't check $here."
  exit 1
}
while IFS= read -r line; do
  # The '~/' patterns are the file's literal text, not expansions.
  # shellcheck disable=SC2088
  case "$line" in
    '' | '#'*) continue ;;
    '~/'*) pattern="$home/${line#'~/'}" ;;
    *) pattern="$line" ;;
  esac
  for dir in "$root" "$here"; do
    # Unquoted on purpose: $pattern is a pattern.
    # shellcheck disable=SC2254
    case "$dir" in
      $pattern) refuse "$dir matches \"$line\" in $forbidden." ;;
    esac
  done
done < "$forbidden"

case "$cmd" in
  key) printf '%s\n' "$key"; exit 0 ;;
  root) printf '%s\n' "$root"; exit 0 ;;
  dossier) printf '%s\n' "$dossier"; exit 0 ;;
esac

# prepare.
[ -w "$root" ] || { say "can't write $root, so it can't be a workspace."; exit 1; }
new=false
if [ ! -e "$dossier" ] && [ ! -L "$dossier" ]; then
  # Outside ~/projects and ~/sensitive, a new workspace is unusual, so
  # ask, in case you started in the wrong place. No answer is "no".
  if ! "$beside" && ! "$yes"; then
    printf 'bulkhead: make %s a workspace, with its dossier in %s? [y/N] ' "$root" "$dossier" >&2
    answer=""
    read -r answer 2> /dev/null < /dev/tty || echo >&2
    case "$answer" in
      y | Y | yes | YES | Yes) ;;
      *) say "not making $root a workspace."; exit 1 ;;
    esac
  fi
  "$beside" || make_central
  mkdir -m 700 "$dossier" 2> /dev/null ||
    { say "can't create $dossier, which every workspace needs (see compartments.md)."; exit 1; }
  new=true
fi
if [ -L "$dossier" ] || [ ! -d "$dossier" ] || [ "$(stat -c %u "$dossier")" != "$(id -u)" ]; then
  say "$dossier isn't a directory you own; refusing to use it."
  exit 1
fi
chmod 700 "$dossier"
for d in state logs policy git inbox outbox; do
  [ -d "$dossier/$d" ] || mkdir -m 700 "$dossier/$d"
done
# Only if missing, so your edits stay.
if [ ! -e "$dossier/policy/local-ports" ]; then
  cat > "$dossier/policy/local-ports" <<'PORTS'
# Extra local TCP ports this workspace's agents may use (connect and
# listen), one port number per line (e.g., 8089). Lines starting with
# "#", and blank lines, don't count. With none listed, each agent gets
# its own private loopback instead, where it can use any port, and
# can't see the VM's other ports. See compartments.md.
PORTS
fi
if [ ! -e "$dossier/policy/expose-ports" ]; then
  cat > "$dossier/policy/expose-ports" <<'PORTS'
# Local TCP ports this workspace's agents may listen on that you can
# reach from the VM, at 127.0.0.1:PORT (e.g., a dev server you open in
# a browser), one port number per line (e.g., 3000). Lines starting
# with "#", and blank lines, don't count. Agents may use these ports
# too, as if in local-ports. Other compartments can't reach them; other
# processes on the VM can. See compartments.md.
PORTS
fi

# Notice moves: DOSSIER/workspace records the workspace it was made for.
recorded="$(cat "$dossier/workspace" 2> /dev/null || :)"
if "$new"; then
  say "created $dossier for this workspace. If you moved $root here from elsewhere, replace $dossier with its old dossier (see bulkhead-workspace orphans)."
elif [ "$recorded" != "$root" ]; then
  say "$dossier was for ${recorded:-an unrecorded path}; it's now for $root (you moved them together, I assume)."
fi
[ "$recorded" = "$root" ] || printf '%s\n' "$root" > "$dossier/workspace"

# TRANSITIONAL: remove the rest of prepare (up to printing the dossier)
# once every VM has run it; it moves older layouts into the dossier.
# Move an old .bulkhead's state in, but only one we made (its
# .gitignore is "*") that git doesn't track: anything else may have
# arrived with the workspace's contents, which is why state moved.
dotdir="$root/.bulkhead"
if [ -d "$dotdir" ] && [ ! -L "$dotdir" ]; then
  if [ -z "$(ls -A "$dossier/state")" ] &&
    [ "$(cat "$dotdir/.gitignore" 2> /dev/null)" = '*' ] &&
    [ -z "$(git -C "$root" ls-files -- .bulkhead 2> /dev/null)" ]; then
    rm -f "$dotdir/.gitignore"
    for f in "$dotdir"/* "$dotdir"/.[!.]* "$dotdir"/..?*; do
      if [ -e "$f" ] || [ -L "$f" ]; then mv "$f" "$dossier/state/"; fi
    done
    rmdir "$dotdir"
    say "moved $dotdir's contents into $dossier/state."
  else
    say "WARNING: $dotdir isn't used anymore, and I didn't move it into $dossier/state; look it over, then remove it."
  fi
fi
# Old logs from ~/.local/state/bulkhead/logs/KEY.
oldlogs="$home/.local/state/bulkhead/logs/$key"
if [ -d "$oldlogs" ]; then
  for f in "$oldlogs"/*; do
    if [ -e "$f" ] && [ ! -e "$dossier/logs/${f##*/}" ]; then mv "$f" "$dossier/logs/"; fi
  done
  rmdir "$oldlogs" "$(dirname "$oldlogs")" 2> /dev/null || :
fi

printf '%s\n' "$dossier"
