#!/bin/sh
# bulkhead-workspace-ports: print, one per line, the ports or ranges
# (e.g., 8089 or 3000-3010) listed in the current directory's workspace
# dossier, after checking them:
#
#   local   DOSSIER/policy/local-ports plus expose-ports: ports the
#           agent may use (connect and listen) on its own loopback
#   expose  DOSSIER/policy/expose-ports: ports the agent listens on that
#           you can reach from the VM, at 127.0.0.1 only
#
# Each file has one port or range per line; "#" starts a comment. A
# missing file lists nothing. bulkhead-workspace-nono-args turns "local"
# into nono's --open-port, and bulkhead-compartment turns "expose" into
# pasta's --tcp-ports. Run it outside the sandbox (they do).
#
# Usage: bulkhead-workspace-ports local|expose
set -eu

case "${1:-}" in
  local) files="local-ports expose-ports" ;;
  expose) files="expose-ports" ;;
  *)
    echo "Usage: bulkhead-workspace-ports local|expose" >&2
    exit 2
    ;;
esac
info="$(dirname "$0")/bulkhead-compartment-info"
dossier="$("$info" dossier)"

for f in $files; do
  file="$dossier/policy/$f"
  [ -f "$file" ] || continue
  while IFS= read -r line; do
    line="${line%%#*}"
    # Trim blanks.
    line="$(printf '%s' "$line" | tr -d ' \t')"
    [ -n "$line" ] || continue
    case "$line" in
      # No leading zeros: shell arithmetic would read 010 as octal.
      *[!0-9-]* | -* | *- | *-*-* | 0* | *-0*)
        echo "bulkhead: $file: not a port or range: $line" >&2
        exit 1
        ;;
      *-*) first="${line%-*}" last="${line#*-}" ;;
      *) first="$line" last="$line" ;;
    esac
    if [ "$first" -lt 1 ] || [ "$last" -gt 65535 ] || [ "$first" -gt "$last" ]; then
      echo "bulkhead: $file: not a port or range (1-65535): $line" >&2
      exit 1
    fi
    echo "$line"
  done < "$file"
done
