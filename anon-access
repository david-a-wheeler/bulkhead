#!/bin/sh
# anon-access: run a command (by default, your shell) in the current
# directory's compartment (see bulkhead-compartment), without the
# login and auth variables in its environment, so it (e.g., an AI
# harness) can't use them. compart runs every harness through this.
#
# Usage: anon-access [BULKHEAD-COMPARTMENT-OPTION...] [COMMAND [ARG...]]
# Options (e.g., --forward-port PORT) go to bulkhead-compartment.
#
# We remove the variables we know are secrets, rather than pass on only
# known-safe ones (env -i), because harnesses need much of your
# environment. That's defense in depth: the main defense is that VMs
# hold no long-lived secrets.
set -eu

# Refuse a directory no agent may start in (e.g., ~ or ~/projects)
# before anything else, and set up its dossier. See bulkhead-workspace.
"$(dirname "$0")/bulkhead-workspace" prepare > /dev/null

# gh refuses to run without a token, even for public data
# (https://github.com/cli/cli/issues/13307). So instead of your token,
# we give it GH_PUBLIC_TOKEN, a "Public Repositories (read-only)"
# fine-grained PAT that the Mac releases without asking (its name in
# the Keychain ends in "!"; see rotate-github-pat.sh), since leaking it
# does no more harm than having no token. We fetch it here, while we
# still have BULKHEAD_AUTH_SESSION. If that fails, gh treats the empty
# token as none, so gh just doesn't work.
public_token="$(secrets-client --context "anon-access: ${*:-interactive shell}" --get GH_PUBLIC_TOKEN 2> /dev/null)" || public_token=""

# A per-directory temp and cache directory, not the shared /tmp and
# ~/.cache, so a tool run in one directory (e.g., pip or npm) can't read
# or poison another's. npm ignores XDG_CACHE_HOME, so we tell it too.
export TMPDIR="$PWD/.tmp"
export XDG_CACHE_HOME="$PWD/.cache"
export npm_config_cache="$XDG_CACHE_HOME/npm"
mkdir -p "$TMPDIR" "$XDG_CACHE_HOME"

# GH_CONFIG_DIR is a new, empty directory, so gh sees none of your
# config. Each run leaves one in $TMPDIR, which is harmless.
#
# With no command, we run your shell. The inner fallback matters: with
# no arguments and an empty $SHELL, "${@:-$SHELL}" gives one empty
# argument, which exec can't run.
exec env -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN \
  -u SSH_AUTH_SOCK -u HEROKU_API_KEY -u BULKHEAD_AUTH_SESSION \
  GH_CONFIG_DIR="$(mktemp -d)" \
  GH_TOKEN="$public_token" GITHUB_TOKEN="$public_token" \
  "$(dirname "$0")/bulkhead-compartment" "${@:-${SHELL:-/bin/sh}}"
