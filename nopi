#!/bin/sh
# nopi: run pi against the Mac's local AI models, which llama-swap
# serves through this VM's SSH tunnel (see local-ai-plan.md). pi runs
# under nono (the nolabs-ai/pi profile, through anon-access like
# noclaude), with no automatic network activity of its own (no model
# catalog refresh, version check, or telemetry). The API key comes from a
# file only you can read, and reaches pi only through its environment.
# vm-setup.sh installs this.
#
# Each time, it asks the engine what it serves now (infer-models), and
# writes pi's list of models (~/.pi/agent/models.json, by pi-models.jq)
# if that changed, keeping the old one as models.json.bak. So a change on
# the Mac (see manage-models.sh there) reaches pi the next time you start
# it. The default is the one the Mac's list marks "default: true" (see
# ./manage-models.sh default there). If the engine doesn't answer, pi
# uses the list it had.
#
# It also exports infer-models' answer in INFER_MODELS, with the key in
# INFER_API_KEY, for tools pi runs that need them.
#
# Usage: nopi [pi arguments...], e.g., nopi --print "Say hello"
# or nopi --model qwen3-0.6b (a later --model overrides the default).

set -eu

# vm-setup.sh installs pi where "npm install -g" would.
PI_DIR=/usr/local/lib/node_modules/@earendil-works/pi-coding-agent
LIB_DIR=/usr/local/libexec/bulkhead
KEY_FILE="$HOME/.config/bulkhead/infer-api-key"
AGENT_DIR="$HOME/.pi/agent"

default=""
if models="$(/usr/local/bin/infer-models)"; then
  mkdir -p "$AGENT_DIR"
  new="$(mktemp "$AGENT_DIR/models.json.XXXXXX")"
  printf '%s' "$models" | jq -f "$LIB_DIR/pi-models.jq" > "$new" ||
    { rm -f "$new"; exit 1; }
  if cmp -s "$new" "$AGENT_DIR/models.json"; then
    rm -f "$new"
  else
    [ ! -f "$AGENT_DIR/models.json" ] || cp "$AGENT_DIR/models.json" "$AGENT_DIR/models.json.bak"
    mv "$new" "$AGENT_DIR/models.json"
  fi
  default="$(printf '%s' "$models" | jq -r '.default // empty')"
  [ -n "$default" ] ||
    echo "nopi: WARNING: the engine has no default model (see ./manage-models.sh default on the Mac)." >&2
else
  models=""
  echo "nopi: WARNING: using pi's last list of models; INFER_MODELS is empty." >&2
fi
[ -z "$default" ] || set -- --model "$default" "$@"

INFER_API_KEY="$(cat "$KEY_FILE")"
INFER_MODELS="$models"
PI_OFFLINE=1
PI_SKIP_VERSION_CHECK=1
PI_TELEMETRY=0
export INFER_API_KEY INFER_MODELS PI_OFFLINE PI_SKIP_VERSION_CHECK PI_TELEMETRY

exec anon-access nono run --profile nolabs-ai/pi --allow-cwd --read "$PI_DIR" -- \
  /usr/local/bin/pi --provider mac-local "$@"
