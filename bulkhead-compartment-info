#!/bin/sh
# bulkhead-compartment-info: print one fact about a directory's
# workspace (see compartments.md), so every script computes it
# the same way. It refuses (exits 1, saying why) a directory no agent
# should start in, whatever the field.
#
# Usage: bulkhead-compartment-info FIELD [DIR]
# DIR defaults to the current directory. FIELD is one of:
#   key       the workspace's name: projects-NAME, sensitive-NAME, or
#             dir%PATH (its path with "/" as "%")
#   root      the workspace's top directory
#   dossier   ROOT.dossier, beside it: data about the workspace that its
#             agent mustn't fully control, or that mustn't arrive with
#             the workspace's contents
#   state     DOSSIER/state: the harness's private files (bwrap binds them
#             over ~/.claude and the like, read-write)
#   logs      DOSSIER/logs: e.g., nono's log (no agent access)
#   registry  the file listing every workspace that has had a dossier
#             (no refusal checks for this one)
#
# The workspace is ~/projects/NAME or ~/sensitive/NAME when DIR's real
# path is in one of them; else the nearest registered workspace that
# holds DIR; else DIR itself.
#
# It refuses DIR when DIR or its workspace matches a pattern in
# workspace-forbidden ($BULKHEAD_WORKSPACE_FORBIDDEN, else the installed
# copy), when the workspace is ~ or above it (an agent there would be
# granted every workspace's dossier), or when the workspace holds another
# workspace's dossier (its agent could change that one).
set -eu

usage() {
  echo "Usage: bulkhead-compartment-info key|root|dossier|state|logs|registry [DIR]" >&2
  exit 2
}
[ "$#" -ge 1 ] && [ "$#" -le 2 ] || usage
field="$1"
here="$(cd "${2:-.}" && pwd -P)"
home="$(cd "$HOME" && pwd -P)"
# Not $XDG_STATE_HOME: nono-claude-profile.json grants one directory
# under ~/.local/state/bulkhead, and this must stay outside it.
registry="$home/.local/state/bulkhead/workspaces"
if [ "$field" = registry ]; then
  printf '%s\n' "$registry"
  exit 0
fi
forbidden="${BULKHEAD_WORKSPACE_FORBIDDEN:-/usr/local/libexec/bulkhead/workspace-forbidden}"

refuse() {
  echo "bulkhead: no agent may start in $here: $1" >&2
  exit 1
}

case "$here/" in
  "$home"/projects/?*/* | "$home"/sensitive/?*/*)
    rest="${here#"$home"/}"
    top="${rest%%/*}"
    rest="${rest#*/}"
    key="$top-${rest%%/*}"
    root="$home/$top/${rest%%/*}"
    ;;
  *)
    root=""
    if [ -r "$registry" ]; then
      while IFS= read -r ws; do
        [ -n "$ws" ] || continue
        case "$here/" in
          "$ws"/*) [ "${#ws}" -le "${#root}" ] || root="$ws" ;;
        esac
      done < "$registry"
    fi
    [ -n "$root" ] || root="$here"
    # "/" becomes "%" so the key is one path component.
    key="dir$(printf '%s' "$root" | tr '/' '%')"
    ;;
esac

case "$home/" in
  "${root%/}"/*) refuse "$root holds your home directory, so an agent there could change every workspace's dossier." ;;
esac
[ -r "$forbidden" ] || {
  echo "bulkhead: can't read $forbidden, so can't check $here." >&2
  exit 1
}
while IFS= read -r line; do
  # The '~/' patterns are the file's literal text, not expansions.
  # shellcheck disable=SC2088
  case "$line" in
    '' | '#'*) continue ;;
    '~/'*) pattern="$home/${line#'~/'}" ;;
    *) pattern="$line" ;;
  esac
  for dir in "$root" "$here"; do
    # Unquoted on purpose: $pattern is a pattern.
    # shellcheck disable=SC2254
    case "$dir" in
      $pattern) refuse "$dir matches \"$line\" in $forbidden." ;;
    esac
  done
done < "$forbidden"
if [ -r "$registry" ]; then
  while IFS= read -r ws; do
    [ -n "$ws" ] || continue
    case "$ws/" in
      "$root"/?*)
        [ ! -d "$ws.dossier" ] ||
          refuse "$root holds $ws.dossier, another workspace's dossier. Start in $ws instead, or move it out of $root."
        ;;
    esac
  done < "$registry"
fi

case "$field" in
  key) printf '%s\n' "$key" ;;
  root) printf '%s\n' "$root" ;;
  dossier) printf '%s\n' "$root.dossier" ;;
  state) printf '%s\n' "$root.dossier/state" ;;
  logs) printf '%s\n' "$root.dossier/logs" ;;
  *) usage ;;
esac
