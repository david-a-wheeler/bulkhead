#!/bin/sh
# bulkhead-workspace-prepare: check the current directory's workspace
# and set up its .meta beside it (see compartment-meta-plan.md and
# bulkhead-compartment-info). anon-access runs this before anything
# else, outside every sandbox: nono binds grants at start, so a
# directory made later stays denied. Safe to re-run.
#
# Usage: bulkhead-workspace-prepare [--orphans]
# --orphans instead lists each registered workspace's .meta whose
# workspace is gone (moved or deleted without it).
#
# It fails (exit 1, saying why) if the directory is refused, if you
# can't write the workspace or create its .meta, or if the .meta isn't
# yours. It moves an old WORKSPACE/.bulkhead into META/state, and old
# logs from ~/.local/state/bulkhead/logs/KEY into META/logs.
set -eu

info="$(dirname "$0")/bulkhead-compartment-info"
say() {
  echo "bulkhead: $*" >&2
}
registry="$("$info" registry)"

if [ "${1:-}" = --orphans ]; then
  [ -r "$registry" ] || exit 0
  while IFS= read -r ws; do
    if [ -n "$ws" ] && [ ! -d "$ws" ] && [ -d "$ws.meta" ]; then
      printf '%s\n' "$ws.meta"
    fi
  done < "$registry"
  exit 0
fi
[ "$#" -eq 0 ] || { echo "Usage: bulkhead-workspace-prepare [--orphans]" >&2; exit 2; }

# Each call refuses a forbidden directory, so stop at the first.
root="$("$info" root)" || exit 1
key="$("$info" key)"
meta="$("$info" meta)"
state="$("$info" state)"
logs="$("$info" logs)"

[ -w "$root" ] || { say "can't write $root, so it can't be a workspace."; exit 1; }
new=false
if [ ! -e "$meta" ] && [ ! -L "$meta" ]; then
  mkdir -m 700 "$meta" 2> /dev/null ||
    { say "can't create $meta, which every workspace needs (see compartment-meta-plan.md)."; exit 1; }
  new=true
fi
if [ -L "$meta" ] || [ ! -d "$meta" ] || [ "$(stat -c %u "$meta")" != "$(id -u)" ]; then
  say "$meta isn't a directory you own; refusing to use it."
  exit 1
fi
chmod 700 "$meta"
for d in "$state" "$logs" "$meta/policy"; do
  [ -d "$d" ] || mkdir -m 700 "$d"
done

# Notice moves: META/workspace records the workspace it was made for.
recorded="$(cat "$meta/workspace" 2> /dev/null || :)"
if "$new"; then
  say "created $meta for this workspace. If you moved $root here from elsewhere, replace $meta with its old .meta."
elif [ "$recorded" != "$root" ]; then
  say "$meta was for ${recorded:-an unrecorded path}; it's now for $root (you moved them together, I assume)."
fi
[ "$recorded" = "$root" ] || printf '%s\n' "$root" > "$meta/workspace"

# Register it, dropping the old path if that workspace is gone.
old="$root"
if [ -n "$recorded" ] && [ "$recorded" != "$root" ] && [ ! -d "$recorded" ]; then
  old="$recorded"
fi
if ! grep -qsFx -- "$root" "$registry" || grep -qsFx -- "$old" "$registry"; then
  mkdir -p "$(dirname "$registry")"
  { grep -svFx -e "$root" -e "$old" "$registry" || :; printf '%s\n' "$root"; } > "$registry.new"
  mv -f "$registry.new" "$registry"
fi

# Move an old .bulkhead's state in, but only one we made (its
# .gitignore is "*") that git doesn't track: anything else may have
# arrived with the workspace's contents, which is why state moved.
dotdir="$root/.bulkhead"
if [ -d "$dotdir" ] && [ ! -L "$dotdir" ]; then
  if [ -z "$(ls -A "$state")" ] &&
    [ "$(cat "$dotdir/.gitignore" 2> /dev/null)" = '*' ] &&
    [ -z "$(git -C "$root" ls-files -- .bulkhead 2> /dev/null)" ]; then
    rm -f "$dotdir/.gitignore"
    for f in "$dotdir"/* "$dotdir"/.[!.]* "$dotdir"/..?*; do
      if [ -e "$f" ] || [ -L "$f" ]; then mv "$f" "$state/"; fi
    done
    rmdir "$dotdir"
    say "moved $dotdir's contents into $state."
  else
    say "WARNING: $dotdir isn't used anymore, and I didn't move it into $state; look it over, then remove it."
  fi
fi
oldlogs="$(dirname "$registry")/logs/$key"
if [ -d "$oldlogs" ]; then
  for f in "$oldlogs"/*; do
    if [ -e "$f" ] && [ ! -e "$logs/${f##*/}" ]; then mv "$f" "$logs/"; fi
  done
  rmdir "$oldlogs" "$(dirname "$oldlogs")" 2> /dev/null || :
fi
