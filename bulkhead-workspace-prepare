#!/bin/sh
# bulkhead-workspace-prepare: check the current directory's workspace
# and set up its dossier beside it (see workspace-dossier-plan.md and
# bulkhead-compartment-info). anon-access runs this before anything
# else, outside every sandbox: nono binds grants at start, so a
# directory made later stays denied. Safe to re-run.
#
# The dossier gets state/ (the harness's private files), logs/,
# policy/ (with a commented local-ports), inbox/, and outbox/.
#
# Usage: bulkhead-workspace-prepare [--orphans]
# --orphans instead lists each registered workspace's dossier whose
# workspace is gone (moved or deleted without it).
#
# It fails (exit 1, saying why) if the directory is refused, if you
# can't write the workspace or create its dossier, or if the dossier isn't
# yours. It moves an old WORKSPACE/.bulkhead into DOSSIER/state, and old
# logs from ~/.local/state/bulkhead/logs/KEY into DOSSIER/logs.
set -eu

info="$(dirname "$0")/bulkhead-compartment-info"
say() {
  echo "bulkhead: $*" >&2
}
registry="$("$info" registry)"

if [ "${1:-}" = --orphans ]; then
  [ -r "$registry" ] || exit 0
  while IFS= read -r ws; do
    if [ -n "$ws" ] && [ ! -d "$ws" ] && [ -d "$ws.dossier" ]; then
      printf '%s\n' "$ws.dossier"
    fi
  done < "$registry"
  exit 0
fi
[ "$#" -eq 0 ] || { echo "Usage: bulkhead-workspace-prepare [--orphans]" >&2; exit 2; }

# Each call refuses a forbidden directory, so stop at the first.
root="$("$info" root)" || exit 1
key="$("$info" key)"
dossier="$("$info" dossier)"
state="$("$info" state)"
logs="$("$info" logs)"

[ -w "$root" ] || { say "can't write $root, so it can't be a workspace."; exit 1; }
new=false
if [ ! -e "$dossier" ] && [ ! -L "$dossier" ]; then
  mkdir -m 700 "$dossier" 2> /dev/null ||
    { say "can't create $dossier, which every workspace needs (see workspace-dossier-plan.md)."; exit 1; }
  new=true
fi
if [ -L "$dossier" ] || [ ! -d "$dossier" ] || [ "$(stat -c %u "$dossier")" != "$(id -u)" ]; then
  say "$dossier isn't a directory you own; refusing to use it."
  exit 1
fi
chmod 700 "$dossier"
for d in "$state" "$logs" "$dossier/policy" "$dossier/inbox" "$dossier/outbox"; do
  [ -d "$d" ] || mkdir -m 700 "$d"
done
# Only if missing, so your edits stay.
if [ ! -e "$dossier/policy/local-ports" ]; then
  cat > "$dossier/policy/local-ports" <<'PORTS'
# Extra local TCP ports this workspace's agents may use (connect and
# listen), one port (e.g., 8089) or range (e.g., 3000-3010) per line.
# With none listed, each agent gets its own private loopback instead,
# where it can use any port, and can't see the VM's other ports.
# See bulkhead-workspace-nono-args.
PORTS
fi

# Notice moves: DOSSIER/workspace records the workspace it was made for.
recorded="$(cat "$dossier/workspace" 2> /dev/null || :)"
if "$new"; then
  say "created $dossier for this workspace. If you moved $root here from elsewhere, replace $dossier with its old dossier."
elif [ "$recorded" != "$root" ]; then
  say "$dossier was for ${recorded:-an unrecorded path}; it's now for $root (you moved them together, I assume)."
fi
[ "$recorded" = "$root" ] || printf '%s\n' "$root" > "$dossier/workspace"

# Register it, dropping the old path if that workspace is gone.
old="$root"
if [ -n "$recorded" ] && [ "$recorded" != "$root" ] && [ ! -d "$recorded" ]; then
  old="$recorded"
fi
if ! grep -qsFx -- "$root" "$registry" || grep -qsFx -- "$old" "$registry"; then
  mkdir -p "$(dirname "$registry")"
  { grep -svFx -e "$root" -e "$old" "$registry" || :; printf '%s\n' "$root"; } > "$registry.new"
  mv -f "$registry.new" "$registry"
fi

# Move an old .bulkhead's state in, but only one we made (its
# .gitignore is "*") that git doesn't track: anything else may have
# arrived with the workspace's contents, which is why state moved.
dotdir="$root/.bulkhead"
if [ -d "$dotdir" ] && [ ! -L "$dotdir" ]; then
  if [ -z "$(ls -A "$state")" ] &&
    [ "$(cat "$dotdir/.gitignore" 2> /dev/null)" = '*' ] &&
    [ -z "$(git -C "$root" ls-files -- .bulkhead 2> /dev/null)" ]; then
    rm -f "$dotdir/.gitignore"
    for f in "$dotdir"/* "$dotdir"/.[!.]* "$dotdir"/..?*; do
      if [ -e "$f" ] || [ -L "$f" ]; then mv "$f" "$state/"; fi
    done
    rmdir "$dotdir"
    say "moved $dotdir's contents into $state."
  else
    say "WARNING: $dotdir isn't used anymore, and I didn't move it into $state; look it over, then remove it."
  fi
fi
oldlogs="$(dirname "$registry")/logs/$key"
if [ -d "$oldlogs" ]; then
  for f in "$oldlogs"/*; do
    if [ -e "$f" ] && [ ! -e "$logs/${f##*/}" ]; then mv "$f" "$logs/"; fi
  done
  rmdir "$oldlogs" "$(dirname "$oldlogs")" 2> /dev/null || :
fi
