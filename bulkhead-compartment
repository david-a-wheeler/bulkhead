#!/bin/sh
# bulkhead-compartment: run a command in the current directory's
# compartment, so that what one project's agent writes, another
# project's agent can't read (or run). anon-access runs every command
# through this; nono then sandboxes the command inside it.
#
# The compartment is the current directory's workspace (see
# bulkhead-workspace, which refuses directories no agent may start in).
# Its state lives in the workspace's dossier (DOSSIER/state), outside
# the workspace, so it can't arrive with the workspace's contents (see
# compartments.md); "bulkhead-workspace prepare" (run by anon-access)
# creates it. We use bubblewrap (bwrap), unprivileged, to mount over
# the paths that compartment-paths lists:
# e.g., a private /tmp and a private ~/.claude. Everything else is the
# real filesystem, still limited by nono.
#
# We run bwrap under pasta (from passt), which gives each run its own
# network namespace with its own loopback, so an agent can't see the
# VM's listening ports and sockets in /proc/self/net. nono can't make
# the namespace itself here: Ubuntu's AppArmor profile for bwrap denies
# it the capability (see compartments.md). pasta gives the
# namespace a route out (nftables still applies; nono's proxy and
# sandbox still limit the agent) and DNS through the VM's resolver.
# It forwards no ports in either direction, and doesn't map any address
# to the VM's loopback, except:
# - each --forward-port PORT: a connection to 127.0.0.1:PORT inside
#   reaches 127.0.0.1:PORT on the VM (e.g., the local AI engine's tunnel).
# - each --expose-port PORT (compart passes the dossier's
#   policy/expose-ports): a connection to 127.0.0.1:PORT on the VM
#   reaches the agent's server on PORT inside.
#
# Usage: bulkhead-compartment [--dry-run] [--forward-port PORT]...
#          [--expose-port PORT]... COMMAND [ARG...]
#        bulkhead-compartment --tidy
# --dry-run prints the compartment's key and the pasta and bwrap
# arguments instead of running anything (for tests). --tidy only tidies
# the compartment's copies (see tidy below), as every launch does first.
#
# If bwrap or pasta can't run, this fails rather than silently running
# without a compartment. To run without one anyway, set
# BULKHEAD_NO_COMPARTMENT=1.
set -eu

usage="Usage: bulkhead-compartment [--dry-run] [--nono-profile PROFILE] [--forward-port PORT]... [--expose-port PORT]... COMMAND [ARG...], or bulkhead-compartment --tidy"
dry_run=false
nono_profile=""
tidy_only=false
forward=""
expose=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=true ;;
    --tidy) tidy_only=true ;;
    --nono-profile)
      [ "$#" -ge 2 ] || { echo "$usage" >&2; exit 2; }
      nono_profile="$2"
      shift
      ;;
    --forward-port | --expose-port)
      [ "$#" -ge 2 ] || { echo "$usage" >&2; exit 2; }
      # No leading zeros, so we needn't know how pasta and nono read them.
      case "$2" in
        '' | *[!0-9]* | 0*) echo "bulkhead-compartment: not a port: $2" >&2; exit 2 ;;
      esac
      if [ "$1" = --forward-port ]; then
        forward="${forward:+$forward,}$2"
      else
        expose="${expose:+$expose,}$2"
      fi
      shift
      ;;
    *) break ;;
  esac
  shift
done
"$tidy_only" || [ "$#" -gt 0 ] || { echo "$usage" >&2; exit 2; }

if [ -n "${BULKHEAD_NO_COMPARTMENT:-}" ] && ! "$tidy_only"; then
  echo "bulkhead-compartment: WARNING: running without a compartment." >&2
  exec "$@"
fi

paths_file="${BULKHEAD_COMPARTMENT_PATHS:-/usr/local/libexec/bulkhead/compartment-paths}"
here="$(pwd -P)"
ws="$(dirname "$0")/bulkhead-workspace"
key="$("$ws" key)"
root="$("$ws" root)"
dossier="$("$ws" dossier)"
comp="$dossier/state"
if ! "$dry_run" && [ ! -d "$comp" ]; then
  echo "bulkhead-compartment: no $comp; run \"bulkhead-workspace prepare\" first (anon-access does)." >&2
  exit 1
fi

# Build bwrap's arguments after the command, then rotate the command to
# the end (the usual way to build an argument list in POSIX sh).
ncmd=$#
# pasta's user namespace maps us to root, so map us back to our own
# uid and gid; otherwise programs see uid 0 (e.g., Claude Code then
# picks /tmp/claude-0 and refuses it).
set -- "$@" --unshare-user --uid "$(id -u)" --gid "$(id -g)" --dev-bind / /
# Its own minimal /dev, with its own ptys: the VM's /dev/pts holds
# every terminal (yours and other agents'), and they're all ours, so an
# agent could read their input or write into them. The agent keeps its
# own terminal through the descriptors it inherits.
set -- "$@" --dev /dev
# Its own empty /dev/shm, which the profiles grant (e.g., Python's
# multiprocessing makes its semaphores there); the VM's is everyone's.
set -- "$@" --tmpfs /dev/shm
# Its own empty /run, with only what compartment-paths lists there: the
# VM's /run holds every local service's socket (e.g., Docker's, the
# session bus, systemd's, and your SSH and GPG agents), and nono
# doesn't mediate connecting to a socket by path on Linux (its
# capability file says "linux_unmediated"). XDG_RUNTIME_DIR stays,
# empty, and only ours.
set -- "$@" --tmpfs /run
[ -z "${XDG_RUNTIME_DIR:-}" ] || set -- "$@" --perms 0700 --dir "$XDG_RUNTIME_DIR"
# glibc tries nscd's socket on every user or group lookup, then reads
# /etc/passwd itself. That socket doesn't exist, and nono reports each
# connect it blocks, so every session would end with a useless warning.
# So here it's a socket nothing listens on (nono insists that a socket
# it allows is one), made once in the dossier, out of agents' reach. A
# connect is refused at once, and no real nscd is ever behind it, since
# this /run is ours.
nolisten="$comp/no-listener.sock"
if ! "$dry_run" && [ ! -S "$nolisten" ]; then
  rm -f "$nolisten"
  python3 -I -c 'import socket, sys; socket.socket(socket.AF_UNIX).bind(sys.argv[1])' "$nolisten"
fi
set -- "$@" --ro-bind "$nolisten" /run/nscd/socket
# Other workspaces are hidden: ~/projects and ~/sensitive are empty but
# for this workspace and its dossier's inbox and outbox. nono denies
# their files anyway, but it can't stop connecting to a socket in one
# (e.g., another agent's browser, or its nono supervisor).
for d in "$HOME/projects" "$HOME/sensitive"; do
  [ -d "$d" ] || continue
  d="$(cd "$d" && pwd -P)"
  set -- "$@" --tmpfs "$d"
  for keep in "$root" "$dossier/inbox" "$dossier/outbox"; do
    case "$keep/" in "$d"/*) set -- "$@" --bind "$keep" "$keep" ;; esac
  done
done
# Every key of ours is listed in /proc/keys (and counted in
# /proc/key-users), so a key's name could carry data between
# compartments. Each also gets its own session keyring (see
# new-session-keyring, which bwrap runs: pasta's AppArmor profile
# won't run it from /usr/local/libexec).
# A --ro-bind is nodev, so /dev/null wouldn't open there; writes to it
# are discarded anyway.
set -- "$@" --dev-bind /dev/null /proc/keys --dev-bind /dev/null /proc/key-users
# The compartment's temp directory is the directory's .tmp (on disk,
# not in RAM), as /tmp and as TMPDIR. We always set TMPDIR: pasta's
# AppArmor profile runs its command with "Ux", which has glibc drop
# TMPDIR (among other variables) from the environment, and without it,
# nono expands $TMPDIR (as in bulkhead-claude) to /tmp (see
# compartments.md).
tmp="$here/.tmp"
"$dry_run" || mkdir -p "$tmp"
set -- "$@" --setenv TMPDIR "$tmp"
# The namespace's resolver: an address pasta maps to the VM's own.
# We bind over the file /etc/resolv.conf resolves to (on Ubuntu,
# systemd-resolved's stub file).
resolv="$(readlink -f /etc/resolv.conf)"
set -- "$@" --ro-bind "${BULKHEAD_NETNS_RESOLV:-/usr/local/libexec/bulkhead/netns-resolv.conf}" "$resolv"
# Each private path so far, with its copy: "PATH<tab>COPY" lines.
tab="$(printf '\t')"
privates=""
# tidy PATH: before we bind the ro PATH inside a private path, tidy
# what's at PATH in the compartment's copy. A bind leaves an empty
# placeholder there (bwrap makes one to mount over), which the harness
# would see if PATH were later missing; and a symlink there would
# send the bind elsewhere. So we remove a symlink, and an empty
# placeholder of the wrong kind (a file where PATH is a directory, or
# the reverse) or for a PATH that's gone. Anything else there is the
# compartment's own (e.g., a file pi wrote while PATH was missing),
# so we leave it.
tidy() {
  t_path=""
  t_copy=""
  while IFS="$tab" read -r p c; do
    case "$1" in "$p"/*) [ "${#p}" -le "${#t_path}" ] || { t_path="$p"; t_copy="$c"; } ;; esac
  done << EOF
$privates
EOF
  [ -n "$t_path" ] || return 0
  ph="$t_copy${1#"$t_path"}"
  if [ -L "$ph" ]; then
    rm -f "$ph"
  elif [ -d "$ph" ]; then
    [ -e "$1" ] && [ -d "$1" ] || rmdir "$ph" 2> /dev/null || :
  elif [ -f "$ph" ] && [ ! -s "$ph" ]; then
    [ -e "$1" ] && [ ! -d "$1" ] || rm -f "$ph"
  fi
}
# expand PATH: print a compartment-paths PATH with "~/" and
# "$XDG_RUNTIME_DIR/" expanded, or nothing if XDG_RUNTIME_DIR is unset.
expand() {
  # These patterns are the data file's literal text, not expansions.
  # shellcheck disable=SC2088,SC2016
  case "$1" in
    '~/'*) printf '%s\n' "$HOME/${1#'~/'}" ;;
    '$XDG_RUNTIME_DIR/'*)
      [ -z "${XDG_RUNTIME_DIR:-}" ] || printf '%s\n' "$XDG_RUNTIME_DIR/${1#'$XDG_RUNTIME_DIR/'}"
      ;;
    /*) printf '%s\n' "$1" ;;
    *)
      echo "bulkhead-compartment: $paths_file: bad path: $1" >&2
      return 1
      ;;
  esac
}
# Every path compartment-paths names, of any kind, one per line.
covered=""
while read -r kind path; do
  case "$kind" in '' | '#'*) continue ;; esac
  path="$(expand "$path")" || exit 1
  [ -z "$path" ] || covered="$covered$path
"
done < "$paths_file"
# under PATH TOP: whether PATH is TOP or inside it.
under() {
  case "$1/" in "${2%/}"/*) return 0 ;; esac
  return 1
}
# Private by default: each directory the harness's nono profile lets
# agents write becomes the compartment's own copy, unless
# compartment-paths says otherwise (e.g., ro for your shared setup, or
# shared), or it's the workspace, the dossier, /dev, or /proc. So a
# path a pack grants that we've never heard of (e.g., after an update)
# is never shared between compartments; at worst the harness misses
# what's there. These come first, so compartment-paths' lines inside
# them still apply. We ask nono, which resolves the profile's extends
# and groups, and refuse to start if it can't say.
if [ -n "$nono_profile" ]; then
  # Two steps, since a pipeline's status would be only jq's.
  if ! manifest="$(nono profile show "$nono_profile" --format manifest 2> /dev/null)" ||
    ! writable="$(printf '%s' "$manifest" |
      jq -r '(.filesystem.grants // error("no grants")) | .[] | select(.access != "read" and .type == "directory") | .path')"; then
    echo "bulkhead-compartment: can't find out what nono's $nono_profile lets agents write, so not starting." >&2
    exit 1
  fi
  while IFS= read -r path; do
    case "$path" in '' | /dev | /dev/* | /proc | /proc/*) continue ;; esac
    under "$path" "$root" && continue
    under "$path" "$dossier" && continue
    if under "$root" "$path" || under "$dossier" "$path"; then
      echo "bulkhead-compartment: nono's $nono_profile lets agents write $path, which holds the workspace or its dossier, so not starting." >&2
      exit 1
    fi
    skip=false
    while IFS= read -r c; do
      [ -z "$c" ] || ! under "$path" "$c" || skip=true
    done << EOF
$covered
EOF
    "$skip" && continue
    src="$comp/$(printf '%s' "${path#/}" | tr '/' '%')"
    "$dry_run" || [ -d "$src" ] || mkdir -m 700 "$src"
    set -- "$@" --bind "$src" "$path"
    privates="$privates$path$tab$src
"
  done << EOF
$writable
EOF
fi
while read -r kind path; do
  case "$kind" in '' | '#'*) continue ;; esac
  path="$(expand "$path")" || exit 1
  [ -n "$path" ] || continue
  case "$kind" in
    private)
      # Path relative to /, with "/" as "%", names the private copy.
      src="$comp/$(printf '%s' "${path#/}" | tr '/' '%')"
      if ! "$dry_run"; then
        mkdir -p "$path"
        [ -d "$src" ] || mkdir -m 700 "$src"
      fi
      set -- "$@" --bind "$src" "$path"
      privates="$privates$path$tab$src
"
      ;;
    ro)
      "$dry_run" || tidy "$path"
      [ -e "$path" ] || continue
      set -- "$@" --ro-bind "$path" "$path"
      ;;
    tmpdir)
      set -- "$@" --bind "$tmp" "$path"
      ;;
    shared) ;;
    *)
      echo "bulkhead-compartment: $paths_file: bad kind: $kind" >&2
      exit 1
      ;;
  esac
done < "$paths_file"
! "$tidy_only" || exit 0
set -- "$@" --chdir "$here" -- "${BULKHEAD_LIB_DIR:-/usr/local/libexec/bulkhead}/new-session-keyring"
i=0
while [ "$i" -lt "$ncmd" ]; do
  set -- "$@" "$1"
  shift
  i=$((i + 1))
done

# The address netns-resolv.conf names, and the VM's first IPv4
# resolver (on Ubuntu, systemd-resolved's 127.0.0.53).
dns_host="$(awk '$1 == "nameserver" && $2 ~ /^[0-9.]+$/ { print $2; exit }' /etc/resolv.conf)"
# Exposed ports listen on the VM's 127.0.0.1 only, and forward to the
# namespace, so you (and other processes outside any compartment) can
# reach the agent's servers. Other compartments can't: their 127.0.0.1
# is their own, and only a --forward-port leads to the VM's.
# --host-lo-to-ns-lo has pasta deliver these to the namespace's
# loopback, where agents' servers usually listen; otherwise it sends
# them to the namespace's public address, from the --map-host-loopback
# address, and with that "none" it drops them.
set -- pasta --config-net --quiet \
  --tcp-ports "${expose:+127.0.0.1/}${expose:-none}" \
  ${expose:+--host-lo-to-ns-lo} \
  --udp-ports none --udp-ns none --tcp-ns "${forward:-none}" \
  --map-host-loopback none --map-guest-addr none \
  --dns-forward 169.254.53.53 ${dns_host:+--dns-host "$dns_host"} -- bwrap "$@"

if "$dry_run"; then
  echo "key: $key"
  printf '%s\n' "$@"
  exit 0
fi
export BULKHEAD_COMPARTMENT="$key"
exec "$@"
