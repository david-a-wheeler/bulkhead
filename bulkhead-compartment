#!/bin/sh
# bulkhead-compartment: run a command in the current directory's
# compartment, so that what one project's agent writes, another
# project's agent can't read (or run). anon-access runs every command
# through this; nono then sandboxes the command inside it.
#
# The compartment is ~/projects/NAME or ~/sensitive/NAME when the real
# current directory is in one of them, else the directory itself. Its
# state lives in that directory's .bulkhead, so it moves with a rename,
# and a .gitignore there hides it from git (and ripgrep). We use
# bubblewrap (bwrap), unprivileged, to mount over the paths that
# compartment-paths lists: e.g., a private /tmp and a private ~/.claude.
# Everything else is the real filesystem, still limited by nono.
#
# A repo could ship its own .bulkhead (e.g., a ~/.claude/.claude.json
# that pre-accepts Claude's folder-trust prompt), so we refuse one that
# git tracks. We can't tell for a project that came from a tarball.
#
# Usage: bulkhead-compartment [--dry-run] COMMAND [ARG...]
# --dry-run prints the compartment's key and the bwrap arguments
# instead of running anything (for tests).
#
# If bwrap can't run, this fails rather than silently running without
# a compartment. To run without one anyway, set BULKHEAD_NO_COMPARTMENT=1.
set -eu

dry_run=false
if [ "${1:-}" = --dry-run ]; then
  dry_run=true
  shift
fi
[ "$#" -gt 0 ] || { echo "Usage: bulkhead-compartment [--dry-run] COMMAND [ARG...]" >&2; exit 2; }

if [ -n "${BULKHEAD_NO_COMPARTMENT:-}" ]; then
  echo "bulkhead-compartment: WARNING: running without a compartment." >&2
  exec "$@"
fi

paths_file="${BULKHEAD_COMPARTMENT_PATHS:-/usr/local/libexec/bulkhead/compartment-paths}"
home="$(cd "$HOME" && pwd -P)"
here="$(pwd -P)"

case "$here/" in
  "$home"/projects/?*/* | "$home"/sensitive/?*/*)
    rest="${here#"$home"/}"
    top="${rest%%/*}"
    rest="${rest#*/}"
    key="$top-${rest%%/*}"
    root="$home/$top/${rest%%/*}"
    ;;
  *)
    # Elsewhere, the directory is its own compartment; "/" becomes "%"
    # so the key is one path component.
    key="dir$(printf '%s' "$here" | tr '/' '%')"
    root="$here"
    ;;
esac
comp="$root/.bulkhead"
if [ -n "$(git -C "$root" ls-files -- .bulkhead 2>/dev/null)" ]; then
  echo "bulkhead-compartment: $comp is in git; refusing to use it." >&2
  exit 1
fi

# Build bwrap's arguments after the command, then rotate the command to
# the end (the usual way to build an argument list in POSIX sh).
ncmd=$#
set -- "$@" --dev-bind / /
while read -r kind path; do
  case "$kind" in '' | '#'*) continue ;; esac
  # These patterns are the data file's literal text, not expansions.
  # shellcheck disable=SC2088,SC2016
  case "$path" in
    '~/'*) path="$HOME/${path#'~/'}" ;;
    '$XDG_RUNTIME_DIR/'*)
      [ -n "${XDG_RUNTIME_DIR:-}" ] || continue
      # shellcheck disable=SC2016
      path="$XDG_RUNTIME_DIR/${path#'$XDG_RUNTIME_DIR/'}"
      ;;
    /*) ;;
    *)
      echo "bulkhead-compartment: $paths_file: bad path: $path" >&2
      exit 1
      ;;
  esac
  case "$kind" in
    private)
      # Path relative to /, with "/" as "%", names the private copy.
      src="$comp/$(printf '%s' "${path#/}" | tr '/' '%')"
      if ! "$dry_run"; then
        mkdir -p "$path"
        if [ ! -d "$comp" ]; then
          mkdir -m 700 "$comp"
          echo '*' > "$comp/.gitignore"
        fi
        [ -d "$src" ] || mkdir -m 700 "$src"
      fi
      set -- "$@" --bind "$src" "$path"
      ;;
    ro)
      [ -e "$path" ] || continue
      set -- "$@" --ro-bind "$path" "$path"
      ;;
    tmpfs)
      set -- "$@" --tmpfs "$path"
      ;;
    *)
      echo "bulkhead-compartment: $paths_file: bad kind: $kind" >&2
      exit 1
      ;;
  esac
done < "$paths_file"
set -- "$@" --chdir "$here" --
i=0
while [ "$i" -lt "$ncmd" ]; do
  set -- "$@" "$1"
  shift
  i=$((i + 1))
done

if "$dry_run"; then
  echo "key: $key"
  printf '%s\n' "$@"
  exit 0
fi
export BULKHEAD_COMPARTMENT="$key"
exec bwrap "$@"
