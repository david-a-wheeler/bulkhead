#!/bin/sh
# bulkhead-compartment: run a command in the current directory's
# compartment, so that what one project's agent writes, another
# project's agent can't read (or run). anon-access runs every command
# through this; nono then sandboxes the command inside it.
#
# The compartment is the current directory's workspace (see
# bulkhead-compartment-info, which refuses directories no agent may
# start in). Its state lives in the workspace's .meta/state, beside the
# workspace, not in it, so it can't arrive with the workspace's
# contents (see compartment-meta-plan.md); bulkhead-workspace-prepare
# (run by anon-access) creates it. We use bubblewrap (bwrap),
# unprivileged, to mount over the paths that compartment-paths lists:
# e.g., a private /tmp and a private ~/.claude. Everything else is the
# real filesystem, still limited by nono.
#
# Usage: bulkhead-compartment [--dry-run] COMMAND [ARG...]
# --dry-run prints the compartment's key and the bwrap arguments
# instead of running anything (for tests). bulkhead-compartment-info
# computes the key and where the state lives.
#
# If bwrap can't run, this fails rather than silently running without
# a compartment. To run without one anyway, set BULKHEAD_NO_COMPARTMENT=1.
set -eu

dry_run=false
if [ "${1:-}" = --dry-run ]; then
  dry_run=true
  shift
fi
[ "$#" -gt 0 ] || { echo "Usage: bulkhead-compartment [--dry-run] COMMAND [ARG...]" >&2; exit 2; }

if [ -n "${BULKHEAD_NO_COMPARTMENT:-}" ]; then
  echo "bulkhead-compartment: WARNING: running without a compartment." >&2
  exec "$@"
fi

paths_file="${BULKHEAD_COMPARTMENT_PATHS:-/usr/local/libexec/bulkhead/compartment-paths}"
here="$(pwd -P)"
info="$(dirname "$0")/bulkhead-compartment-info"
key="$("$info" key)"
comp="$("$info" state)"
if ! "$dry_run" && [ ! -d "$comp" ]; then
  echo "bulkhead-compartment: no $comp; run bulkhead-workspace-prepare first (anon-access does)." >&2
  exit 1
fi

# Build bwrap's arguments after the command, then rotate the command to
# the end (the usual way to build an argument list in POSIX sh).
ncmd=$#
set -- "$@" --dev-bind / /
while read -r kind path; do
  case "$kind" in '' | '#'*) continue ;; esac
  # These patterns are the data file's literal text, not expansions.
  # shellcheck disable=SC2088,SC2016
  case "$path" in
    '~/'*) path="$HOME/${path#'~/'}" ;;
    '$XDG_RUNTIME_DIR/'*)
      [ -n "${XDG_RUNTIME_DIR:-}" ] || continue
      # shellcheck disable=SC2016
      path="$XDG_RUNTIME_DIR/${path#'$XDG_RUNTIME_DIR/'}"
      ;;
    /*) ;;
    *)
      echo "bulkhead-compartment: $paths_file: bad path: $path" >&2
      exit 1
      ;;
  esac
  case "$kind" in
    private)
      # Path relative to /, with "/" as "%", names the private copy.
      src="$comp/$(printf '%s' "${path#/}" | tr '/' '%')"
      if ! "$dry_run"; then
        mkdir -p "$path"
        [ -d "$src" ] || mkdir -m 700 "$src"
      fi
      set -- "$@" --bind "$src" "$path"
      ;;
    ro)
      [ -e "$path" ] || continue
      set -- "$@" --ro-bind "$path" "$path"
      ;;
    tmpfs)
      set -- "$@" --tmpfs "$path"
      ;;
    tmpdir)
      # Only a TMPDIR in this directory, so TMPDIR=/tmp (say) can't
      # bring the shared /tmp back.
      td="$(cd "${TMPDIR:-/nonexistent}" 2> /dev/null && pwd -P)" || td=""
      case "${td:-/nonexistent}/" in
        "$here"/?*) set -- "$@" --bind "$td" "$path" ;;
        *) set -- "$@" --tmpfs "$path" ;;
      esac
      ;;
    *)
      echo "bulkhead-compartment: $paths_file: bad kind: $kind" >&2
      exit 1
      ;;
  esac
done < "$paths_file"
set -- "$@" --chdir "$here" --
i=0
while [ "$i" -lt "$ncmd" ]; do
  set -- "$@" "$1"
  shift
  i=$((i + 1))
done

if "$dry_run"; then
  echo "key: $key"
  printf '%s\n' "$@"
  exit 0
fi
export BULKHEAD_COMPARTMENT="$key"
exec bwrap "$@"
