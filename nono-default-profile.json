      "$HOME/.rbenv",
      "$HOME/.gitconfig",
      "$HOME/.agents",
      "/usr/local/sbin",
      "/usr/games",
      "/usr/local/games",
      "/usr/libexec",
      "/usr/local/libexec",
      "/usr/include",
      "/usr/local/include",
      "/usr/local/share",
      "/usr/local/man",
      "/usr/man",
      "/opt/man",
      "$HOME/.local/share/man",
      "$HOME/.local/share/info",
      "$HOME/.local/share/doc",
      "/etc/man_db.conf",
      "/etc/manpath.config",
      "/var/cache/man",
      "/etc/groff",
      "/etc/dpkg",
      "/var/lib/dpkg",
      "/etc/protocols",
      "/etc/rpc",
      "/etc/ethertypes",
      "/etc/shells",
      "/etc/gnutls/config",
      "/etc/magic",
      "/etc/wgetrc",
      "/etc/nanorc",
      "/etc/vim",
      "/etc/emacs",
      "/etc/inputrc",
      "/etc/gdb",
      "/etc/dictionaries-common",
      "/var/lib/aspell",
      "/var/lib/ispell",
      "/var/cache/dictionaries-common",
      "/etc/paperspecs",
      "/var/lib/ghostscript",
      "/etc/xml",
      "/etc/sgml",
      "/var/cache/fontconfig",
      "/etc/fstab",
      "/etc/mime.types",
      "/snap",
      "/etc/fonts"
    ],
    "unix_socket": [
      "$XDG_RUNTIME_DIR/speech-dispatcher/speechd.sock"
    ],
    "allow": [
      "/dev/shm"
    ],
    "unix_socket_subtree_bind": [
      "$WORKDIR",
      "$TMPDIR",
      "/tmp"
    ]
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
