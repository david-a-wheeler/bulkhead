{
  "meta": {
    "name": "bulkhead-claude",
    "description": "nolabs-ai/claude, plus any method on the hosts only Claude Code needs, per-directory temp files, shared credentials (phantom tokens only; nono keeps the real ones), and no telemetry or other nonessential traffic (the network policy refuses it anyway) (see agent-network-plan.md and bulkhead-compartment)"
  },
  "extends": "nolabs-ai/claude",
  "filesystem": {
    "allow": [
      "$HOME/.local/state/bulkhead/claude-credentials"
    ]
  },
  "network": {
    "allow_domain": [
      {"domain": "api.anthropic.com", "endpoints": [{"method": "*", "path": "/**"}]},
      {"domain": "claude.ai", "endpoints": [{"method": "*", "path": "/**"}]},
      {"domain": "platform.claude.com", "endpoints": [{"method": "*", "path": "/**"}]}
    ]
  },
  "credential_providers": {
    "claude_code": {
      "type": "oauth_capture",
      "token_endpoints": [
        {
          "host": "https://platform.claude.com",
          "path": "/v1/oauth/token",
          "response_fields": [
            {"path": "access_token", "kind": "opaque", "format": "sk-ant-oat01-{}"},
            {"path": "refresh_token", "kind": "opaque"},
            {"path": "id_token", "kind": "jwt"}
          ],
          "request_body": "auto",
          "request_nonce_fields": ["access_token", "refresh_token"]
        }
      ],
      "api_hosts": ["https://api.anthropic.com"],
      "credential_store": {
        "type": "file_json",
        "path": "$HOME/.local/state/bulkhead/claude-credentials/.credentials.json",
        "phantom_fields": ["claudeAiOauth.accessToken", "claudeAiOauth.refreshToken"]
      }
    }
  },
  "credential_routes": [
    {"name": "_anthropic_oauth", "provider": "claude_code"}
  ],
  "environment": {
    "set_vars": {
      "CLAUDE_CODE_TMPDIR": "$TMPDIR",
      "TMPDIR": "$TMPDIR",
      "CLAUDE_CONFIG_DIR": "$HOME/.claude",
      "DISABLE_TELEMETRY": "1",
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
    }
  }
}
