#!/bin/sh
# nolabs-ai/claude (installed by vm-setup.sh) is nono's own
# maintained profile for Claude Code, not a hand-rolled --allow list: it
# grants read-write access to $PWD, ~/.claude, and the other paths Claude
# Code actually needs at runtime (~/.claude.json and its lock files,
# ~/.cache/claude, ~/.local/state/claude/locks), while explicitly denying
# the credential/keychain/browser-data/shell-history groups a compromised
# agent would otherwise reach for.
#
# To modify nono defaults edit nono-default-profile.json (this repo) and
# rerun vm-setup.sh; that's what installs it to
# ~/.config/nono/profiles/default.json, which nolabs-ai/claude (and every
# other pack, since it's nono's own "default" profile name) extends. That
# includes the network allowlist every harness shares (see
# agent-network-plan.md). bulkhead-claude (nono-claude-profile.json,
# also installed by vm-setup.sh) extends nolabs-ai/claude with only
# Claude Code's own hosts, and puts Claude's temp files back in
# anon-access's per-directory TMPDIR. Outside ~/sensitive, anon-access
# also adds bulkhead-broad (GET and HEAD to the whole web). For one more
# host for one run, set NONO_ALLOW_DOMAIN (one host), e.g.,
# NONO_ALLOW_DOMAIN=docs.example.org noclaude; in broad mode that only
# matters under ~/sensitive, since bulkhead-broad's GET-only rules
# still apply to it.
#
# Each compartment (see bulkhead-compartment) has its own ~/.claude, but
# they share one credentials directory, so one login works everywhere
# and a token refresh in one reaches the others. bulkhead-claude points
# Claude there (CLAUDE_SECURESTORAGE_CONFIG_DIR). It must exist before
# nono starts, or nono drops the grant; the first time, we copy in the
# login you already have.
creds="${XDG_STATE_HOME:-$HOME/.local/state}/bulkhead/claude-credentials"
if [ ! -d "$creds" ]; then
  mkdir -p "$(dirname "$creds")"
  mkdir -m 700 "$creds"
  if [ -f "$HOME/.claude/.credentials.json" ]; then
    cp -p "$HOME/.claude/.credentials.json" "$creds/"
  fi
fi
exec anon-access nono run --profile bulkhead-claude --allow-cwd -- claude "$@"
