# compartment-paths: what bulkhead-compartment gives each compartment.
# vm-setup.sh installs this in /usr/local/libexec/bulkhead/.
#
# One "KIND PATH" per line; later lines can mount inside earlier ones.
# PATH may start with "~/" or "$XDG_RUNTIME_DIR/" (a line using an
# unset XDG_RUNTIME_DIR is skipped). KIND is:
#   private  the compartment's own copy, empty at first (a directory)
#   ro       the real path, read-only (skipped if it doesn't exist), so
#            your shared setup applies everywhere but no compartment can
#            change it for the others
#   tmpdir   the current directory's .tmp, which is also TMPDIR, so
#            tools that ignore TMPDIR use it too, on disk, not in RAM
#   shared   nothing: every compartment shares it, on purpose (this
#            records that for bulkhead-grant-check)
#
# Anything a harness writes that another compartment could read (or
# run) belongs here. List every harness's paths in this one file.
# bulkhead-grant-check warns about each path a nono profile we use lets
# agents write that isn't here.

tmpdir /tmp

# /run is each compartment's own and empty (see bulkhead-compartment),
# so a socket an agent may use must be listed here. Speech (see
# vm-speech-setup.sh): agents can say things aloud.
ro $XDG_RUNTIME_DIR/speech-dispatcher/speechd.sock

# Caches. anon-access points XDG_CACHE_HOME into the workspace, but
# bulkhead-sh and nolabs-ai/pi grant all of ~/.cache read-write, so a
# tool that ignores XDG_CACHE_HOME would share its cache.
private ~/.cache

# Every harness's shared instructions, skills, and plugins
# (~/.agents/AGENTS.md is the VMs' global instructions). nono's default
# profile grants it read-only, but nolabs-ai/goose grants it read-write
# (for goose's plugins), which would let one compartment's agent change
# every agent's instructions. Change it from outside a compartment.
ro ~/.agents

# nono's profile drafts. The claude, goose, and pi packs grant this
# read-write, so one compartment's agent could leave a file there for
# another's to read. To draft a profile, write it in a workspace, and
# move it here yourself.
ro ~/.config/nono/profile-drafts

# goose (see goose.md). nolabs-ai/goose grants its settings directory
# read-write, and its config.yaml can name extensions, commands goose
# runs at startup, so a shared one would let one compartment's agent run
# code in every other. So it's each compartment's own: goose asks its
# first-run questions (e.g., telemetry) in each, and saves the answers,
# its tool permissions, and any secrets there. Your shared goose setup,
# which shapes what every compartment's goose does, is read-only inside
# it; change it from outside a compartment. Its sessions and logs are
# per compartment too.
private ~/.config/goose
ro ~/.config/goose/AGENTS.md
ro ~/.config/goose/.goosehints
ro ~/.config/goose/adversary.md
ro ~/.config/goose/prompts
ro ~/.config/goose/skills
ro ~/.config/goose/agents
ro ~/.config/goose/recipes
ro ~/.config/goose/custom_providers
private ~/.local/share/goose
private ~/.local/state/goose

# Claude Code. Transcripts, history, todos, plans, and its config file
# (~/.claude/.claude.json, since bulkhead-claude sets CLAUDE_CONFIG_DIR)
# become per compartment. Credentials aren't here: compart claude keeps
# them in one shared directory (CLAUDE_SECURESTORAGE_CONFIG_DIR), so
# one login works everywhere.
private ~/.claude
# One Claude login for every compartment (see compartments.md,
# "Claude's login"); it holds only nono's phantom tokens.
shared ~/.local/state/bulkhead/claude-credentials
# nolabs-ai/claude grants these files in your home directory read-write,
# and a profile that extends it can't take that back. Claude doesn't
# need them here: CLAUDE_CONFIG_DIR keeps its config in its private
# ~/.claude. Read-only, they can't carry anything between compartments,
# and nono can't grant one that doesn't exist at launch.
ro ~/.claude.json
ro ~/.claude.json.lock
ro ~/.claude.lock
ro ~/.claude/CLAUDE.md
ro ~/.claude/settings.json
ro ~/.claude/keybindings.json
ro ~/.claude/agents
ro ~/.claude/commands
ro ~/.claude/hooks
ro ~/.claude/skills
ro ~/.claude/plugins
private ~/.cache/claude
private ~/.cache/claude-cli-nodejs
private ~/.local/state/claude
private $XDG_RUNTIME_DIR/cc-socks

# pi. nolabs-ai/pi grants all of ~/.pi read-write, so it's read-only
# here, except pi's agent directory, which is each compartment's own:
# pi writes lock files beside the files it reads (e.g.,
# trust.json.lock), and its own state there. Your shared pi setup is
# read-only inside it (compart pi rewrites models.json before the
# compartment starts). Each compartment has its own trust.json, so an
# agent can't mark another project trusted. auth.json isn't shared:
# compart pi passes the engine's key in pi's environment, and an
# agent shouldn't read your other logins.
ro ~/.pi
private ~/.pi/agent
private ~/.pi/agent/sessions
ro ~/.pi/agent/settings.json
ro ~/.pi/agent/keybindings.json
ro ~/.pi/agent/models.json
ro ~/.pi/agent/mcp.json
ro ~/.pi/agent/AGENTS.md
ro ~/.pi/agent/SYSTEM.md
ro ~/.pi/agent/APPEND_SYSTEM.md
ro ~/.pi/agent/extensions
ro ~/.pi/agent/skills
ro ~/.pi/agent/prompts
ro ~/.pi/agent/themes
