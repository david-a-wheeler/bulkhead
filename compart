#!/bin/sh
# compart: run an AI harness in this workspace's compartment (see
# compartments.md) under nono, e.g., "compart claude" or
# "compart pi --print 'Say hello'". Each harness's case below adds only
# what it alone needs: its nono profile, any setup, and any extra nono
# options. So adding a harness means adding one case.
# Then, for every harness, we check the workspace, add its nono options
# (from its dossier; see bulkhead-workspace), and run it all through
# anon-access, which strips secrets and starts the compartment. When
# the session ends, we check the workspace again.
#
# "compart sh [COMMAND [ARGUMENTS...]]" runs COMMAND (or, with none,
# your $SHELL) in the compartment, under the same shared policy as any
# harness, e.g., to run code an agent wrote (compart sh make test), to
# see what an agent sees, or to run a tool you don't trust. We exit with
# COMMAND's status, and write our own messages to stderr, so stdout is
# COMMAND's alone.
#
# "compart dossier" prints the workspace's dossier, e.g., for
# cd "$(compart dossier)". It works it out from the workspace's path,
# not from anything an agent can write.
#
# "compart check" checks the workspace as a launch would, plus a few
# things about the VM, and starts nothing. Run it before you run git in
# a workspace after a session you didn't watch.
#
# The sandbox policy every harness shares (files and network) is nono's
# "default" profile, nono-default-profile.json here, which vm-setup.sh
# installs and every nono pack extends. Outside ~/sensitive, we also add
# bulkhead-broad (GET and HEAD to the whole web). To allow one more host
# for one run, set NONO_ALLOW_DOMAIN, e.g.,
# NONO_ALLOW_DOMAIN=docs.example.org compart claude; that matters only
# under ~/sensitive, since elsewhere bulkhead-broad's GET-only rules
# still apply to it. vm-setup.sh installs this.

set -eu

LIB_DIR=/usr/local/libexec/bulkhead
bin="$(dirname "$0")"

usage() {
  echo "Usage: compart HARNESS [ARGUMENTS...], where HARNESS is claude, pi, or goose; compart sh [COMMAND...]; compart dossier; or compart check"
  echo "Use compart sh to run code an agent wrote (e.g., compart sh make test); its exit status is COMMAND's."
}

die() {
  echo "compart: $*" >&2
  exit 1
}

# refuse_real_login FILE: stop if the Claude credentials FILE holds a
# real refresh token (anything but nono's phantoms, nono_...), which
# agents could read (see compartments.md, "Claude's login").
refuse_real_login() {
  [ -f "$1" ] || return 0
  refresh="$(jq -r '.claudeAiOauth.refreshToken // empty' "$1" 2> /dev/null)" ||
    die "can't read $1; delete it, then log in again with /login."
  case "$refresh" in
    '' | nono_*) ;;
    *) die "$1 holds a real Claude login, which agents could read. Delete it, revoke that login in your Claude account's settings, then run compart claude and, if it asks, log in again with /login (see compartments.md, \"Claude's login\")." ;;
  esac
}

# engine_setup HARNESS: for a harness that uses the Mac's local AI
# engine (see local-ai-plan.md), through this VM's SSH tunnel. Sets
# $models to what the engine serves now (infer-models' answer, also
# exported as INFER_MODELS, for tools the harness runs that need it),
# $default to the model the Mac's list marks "default: true", $port to
# the engine's port on 127.0.0.1 (where the tunnel ends), and $forward,
# so that port reaches the compartment. The shared allowlist has no
# model providers; these harnesses need only the engine, a VM service.
# The API key comes from a file only you can read (host-setup.sh on the
# Mac copies it here), and reaches the harness only through its
# environment, as INFER_API_KEY. If the engine doesn't answer, the
# harness can't work, so we stop; infer-models says why.
engine_setup() {
  key_file="$HOME/.config/bulkhead/infer-api-key"
  [ -s "$key_file" ] ||
    die "there's no $key_file; run ./host-setup.sh on the Mac to copy it here."
  models="$(/usr/local/bin/infer-models)" || die "can't reach the engine (see above)."
  default="$(printf '%s' "$models" | jq -r '.default // empty')"
  [ -n "$default" ] ||
    echo "compart $1: WARNING: the engine has no default model (see ./manage-models.sh default on the Mac)." >&2
  url="$(/usr/local/bin/infer-models --url)"
  port="${url#http://127.0.0.1:}"
  port="${port%%/*}"
  forward="$port"
  INFER_API_KEY="$(cat "$key_file")"
  INFER_MODELS="$models"
  export INFER_API_KEY INFER_MODELS
}

# engine_note MODEL: if the engine hasn't loaded MODEL yet (for a
# variant, the model it's a variant of), say so, since then the first
# reply waits while the Mac loads it. Says nothing if the engine doesn't
# answer, so a session still starts.
engine_note() {
  en_id="$(printf '%s' "$models" |
    jq -r --arg m "$1" 'first(.models[] | select(.id == $m) | .variant_of // .id) // $m')"
  en_running="$(printf 'Authorization: Bearer %s\n' "$INFER_API_KEY" |
    curl -s -m 2 -H @- "${url%/v1}/running")" || return 0
  en_state="$(printf '%s' "$en_running" |
    jq -r --arg m "$en_id" 'first(.running[] | select(.model == $m) | .state) // "none"' 2> /dev/null)" ||
    return 0
  [ "$en_state" = ready ] ||
    echo "compart: the engine hasn't loaded $1 yet, so its first reply may take a minute or more." >&2
}

# pi_update_models: rewrite pi's list of models (~/.pi/agent/models.json,
# by pi-models.jq) from $models, if that changed, keeping the old one as
# models.json.bak. So a change on the Mac (see manage-models.sh there)
# reaches pi the next time you start it.
pi_update_models() {
  agent_dir="$HOME/.pi/agent"
  mkdir -p "$agent_dir"
  new="$(mktemp "$agent_dir/models.json.XXXXXX")"
  printf '%s' "$models" | jq -f "$LIB_DIR/pi-models.jq" > "$new" ||
    { rm -f "$new"; exit 1; }
  if cmp -s "$new" "$agent_dir/models.json"; then
    rm -f "$new"
  else
    [ ! -f "$agent_dir/models.json" ] || cp "$agent_dir/models.json" "$agent_dir/models.json.bak"
    mv "$new" "$agent_dir/models.json"
  fi
}

# Each line of a policy file is a port number, except blank lines and
# those starting with "#". A bad line is an error.
ports() {
  [ -f "$1" ] || return 0
  while IFS= read -r p || [ -n "$p" ]; do
    case "$p" in
      '' | '#'*) continue ;;
      *[!0-9]* | 0*) die "$1: not a port number: $p" ;;
    esac
    [ "$p" -le 65535 ] || die "$1: not a port number (1-65535): $p"
    echo "$p"
  done < "$1"
}

# launch_checks AFTER: prepare the workspace's dossier, read its port
# lists, and check its git settings, setting $dossier, $local_ports, and
# $expose_ports. Returns 1 (having said why) if any of that fails, but
# still runs every check it can. An agent can plant git settings that
# run commands when you next run git here, so bulkhead-git-check shows
# you any change since you approved them and asks about risky ones.
# AFTER is true once a session has ended: then a risky change you don't
# approve gets a warning not to run git, rather than "not starting".
launch_checks() {
  lc_ok=true
  dossier="$("$bin/bulkhead-workspace" prepare)" || return 1
  local_ports="$(ports "$dossier/policy/local-ports")" || lc_ok=false
  expose_ports="$(ports "$dossier/policy/expose-ports")" || lc_ok=false
  if "$1"; then
    "$bin/bulkhead-git-check" --after || lc_ok=false
  else
    "$bin/bulkhead-git-check" || lc_ok=false
  fi
  "$lc_ok"
}

# check_workspace AFTER: what "compart check" checks (launch_checks, plus
# the VM's own setup), warning you about anything wrong; returns 1 if
# anything is. It also runs when a session ends, so add new checks here.
check_workspace() {
  cw_ok=true
  launch_checks "$1" || cw_ok=false
  # vm-setup.sh's git pins (see make-git-safety-env) reach you only
  # after a new login.
  if [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/50-bulkhead-git-safety.conf" ]; then
    echo "compart check: WARNING: git's safety settings aren't installed; run vm-setup.sh." >&2
    cw_ok=false
  elif [ -z "${GIT_CONFIG_COUNT:-}" ]; then
    echo "compart check: WARNING: git's safety settings aren't in your environment; log in again." >&2
    cw_ok=false
  fi
  # Every profile a case below uses. A pack update can add a path that
  # every compartment would share.
  "$bin/bulkhead-grant-check" bulkhead-sh bulkhead-claude nolabs-ai/pi nolabs-ai/goose || cw_ok=false
  cw_orphans="$("$bin/bulkhead-workspace" orphans)"
  if [ -n "$cw_orphans" ]; then
    printf 'compart check: WARNING: these dossiers'"'"' workspaces are gone (see compartments.md, "Moving a workspace"):\n%s\n' "$cw_orphans" >&2
    cw_ok=false
  fi
  "$cw_ok" || return 1
  echo "compart check: $(pwd -P) looks as expected." >&2
}

[ $# -gt 0 ] || { usage >&2; exit 2; }
harness="$1"
shift
# Each harness's case sets $profile (its nono profile) and leaves "$@"
# as its own nono options, then "--", then the command to run. It may
# set $forward, VM ports to forward into the compartment (see
# bulkhead-compartment).
forward=""
# A harness that uses the engine sets this to the model it'll use (see
# engine_note).
note_model=""
case "$harness" in
  -h | --help)
    usage
    exit 0
    ;;
  check)
    [ $# -eq 0 ] || { usage >&2; exit 2; }
    check_workspace false || exit 1
    exit 0
    ;;
  dossier)
    [ $# -eq 0 ] || { usage >&2; exit 2; }
    exec "$bin/bulkhead-workspace" dossier
    ;;
  sh)
    # bulkhead-sh (nono-sh-profile.json) is nono's own linux-host-compat
    # plus what the harness packs add for the tools agents run
    # (runtimes, git's config), with a writable workspace. Unlike any
    # harness, it may read bash's startup files (e.g., ~/.bashrc), so
    # your shell works as usual; no sandbox can write them. So never
    # put secrets in them. nono denies writing ~/.bash_history, so we
    # keep history in memory only.
    profile=bulkhead-sh
    HISTFILE=""
    export HISTFILE
    [ $# -gt 0 ] || set -- "${SHELL:-/bin/sh}"
    set -- -- "$@"
    ;;
  claude)
    # bulkhead-claude (nono-claude-profile.json) extends nolabs-ai/claude,
    # nono's own profile for Claude Code, with Claude Code's own hosts.
    #
    # Each compartment has its own ~/.claude, but they share one login,
    # in $creds, which we name in nono's environment (not the profile's
    # set_vars, which nono overrides for this variable). That file must
    # hold only nono's phantom tokens, which work only through nono's
    # proxy, so we refuse a real login there (and, below, in the
    # compartment's own ~/.claude). compartments.md, "Claude's login",
    # says why. The directory must exist before nono starts, or nono
    # drops the grant.
    creds="$HOME/.local/state/bulkhead/claude-credentials"
    if [ ! -d "$creds" ]; then
      mkdir -p "$(dirname "$creds")"
      mkdir -m 700 "$creds"
    fi
    refuse_real_login "$creds/.credentials.json"
    CLAUDE_SECURESTORAGE_CONFIG_DIR="$creds"
    export CLAUDE_SECURESTORAGE_CONFIG_DIR
    profile=bulkhead-claude
    set -- -- claude "$@"
    ;;
  pi)
    # pi runs against the Mac's local AI models (see engine_setup), with
    # no network activity of its own (no model catalog refresh, version
    # check, or telemetry). vm-setup.sh installs pi where
    # "npm install -g" would.
    pi_dir=/usr/local/lib/node_modules/@earendil-works/pi-coding-agent
    [ -x /usr/local/bin/pi ] ||
      die "pi isn't installed on this VM; run ./vm-setup.sh."
    engine_setup pi
    pi_update_models
    # A later --model (in "$@") overrides this. pi refuses --provider
    # without --model, so with no default you must give one.
    if [ -n "$default" ]; then
      set -- --model "$default" "$@"
    else
      case " $* " in
        *" --model "* | *" --model="*) ;;
        *) die "there's no default model to use (see the warning above); pass --model, or set a default on the Mac with ./manage-models.sh default." ;;
      esac
    fi
    # The model pi will use: the last --model.
    prev=""
    for a; do
      [ "$prev" != --model ] || note_model="$a"
      case "$a" in --model=*) note_model="${a#--model=}" ;; esac
      prev="$a"
    done
    case " $* " in
      *" --list-models "* | *" --help "* | *" -h "* | *" --version "*) note_model="" ;;
    esac
    PI_OFFLINE=1
    PI_SKIP_VERSION_CHECK=1
    PI_TELEMETRY=0
    export PI_OFFLINE PI_SKIP_VERSION_CHECK PI_TELEMETRY
    profile=nolabs-ai/pi
    set -- --read "$pi_dir" --open-port "$port" -- /usr/local/bin/pi --provider mac-local "$@"
    ;;
  goose)
    # goose (see goose.md) runs against the Mac's local AI models (see
    # engine_setup), through its OpenAI-compatible provider, set up
    # entirely here, since its settings (~/.config/goose) are read-only
    # in a compartment. Set GOOSE_MODEL to use a model other than the
    # engine's default. goose's own checks (e.g., GOOSE_MODE) are yours
    # to set; they add to the compartment, but don't replace it.
    # GOOSE_DISABLE_KEYRING: a compartment has no keyring service, and
    # the key is in the environment anyway. vm-setup.sh installs goose.
    [ -x /usr/local/bin/goose ] ||
      die "goose isn't installed on this VM; run ./vm-setup.sh."
    engine_setup goose
    GOOSE_MODEL="${GOOSE_MODEL:-$default}"
    [ -n "$GOOSE_MODEL" ] ||
      die "there's no default model to use (see the warning above); set GOOSE_MODEL, or set a default on the Mac with ./manage-models.sh default."
    GOOSE_CONTEXT_LIMIT="$(printf '%s' "$models" |
      jq -r --arg m "$GOOSE_MODEL" '.models[] | select(.id == $m) | .context // empty')"
    [ -n "$GOOSE_CONTEXT_LIMIT" ] ||
      die "the engine serves no text model $GOOSE_MODEL (see infer-models)."
    # Only these use a model.
    case "${1:-session}" in run | session) note_model="$GOOSE_MODEL" ;; esac
    GOOSE_PROVIDER=openai
    OPENAI_HOST="http://127.0.0.1:$port"
    OPENAI_API_KEY="$INFER_API_KEY"
    GOOSE_DISABLE_KEYRING=1
    GOOSE_TELEMETRY_ENABLED=false
    export GOOSE_MODEL GOOSE_CONTEXT_LIMIT GOOSE_PROVIDER OPENAI_HOST OPENAI_API_KEY \
      GOOSE_DISABLE_KEYRING GOOSE_TELEMETRY_ENABLED
    profile=nolabs-ai/goose
    set -- --open-port "$port" -- /usr/local/bin/goose "$@"
    ;;
  *)
    echo "compart: unknown harness: $harness" >&2
    usage >&2
    exit 2
    ;;
esac

launch_checks false || exit 1
# Claude's ~/.claude, as the agent will see it: the compartment's private
# copy (named as bulkhead-compartment names it), or, with
# BULKHEAD_NO_COMPARTMENT, your own.
if [ "$harness" = claude ]; then
  if [ -n "${BULKHEAD_NO_COMPARTMENT:-}" ]; then
    refuse_real_login "$HOME/.claude/.credentials.json"
  else
    refuse_real_login "$dossier/state/$(printf '%s' "${HOME#/}/.claude" | tr '/' '%')/.credentials.json"
  fi
fi

# The rest of the command line, besides the harness's own part:
#   anon-access --nono-profile PROFILE [--forward-port P]... [--expose-port P]...
#     nono run --profile PROFILE --allow-cwd [--extends bulkhead-broad]
#       [--log-file LOG] --read INBOX --write OUTBOX [--open-port P]...
#       HARNESS-NONO-OPTIONS -- COMMAND...
# anon-access strips secrets, then runs bulkhead-compartment with the
# same arguments. That takes the options and runs, nested:
#   pasta: a private network namespace, passing only those ports;
#   bwrap: private mounts (compartment-paths, e.g., /tmp and ~/.claude,
#     and each other directory PROFILE lets agents write);
#   nono run ...: the sandbox, which then runs COMMAND.
#
# Ports are only digits (ports checks them), and profile names have no
# spaces, so we can split them.
compartment_opts="--nono-profile $profile"
for p in $forward; do compartment_opts="$compartment_opts --forward-port $p"; done
for p in $expose_ports; do compartment_opts="$compartment_opts --expose-port $p"; done
# The workspace's local ports (and exposed ones, which its agents use
# too) are on the compartment's own loopback, but nono still refuses any
# port not opened.
open_opts=""
for p in $local_ports $expose_ports; do open_opts="$open_opts --open-port $p"; done
# Most work isn't sensitive, so we add bulkhead-broad (GET and HEAD to
# the whole web; see agent-network-plan.md), except under ~/sensitive (by
# real path), where only the narrow allowlist in nono's "default"
# profile applies.
broad=bulkhead-broad
sensitive="$(cd "$HOME/sensitive" 2> /dev/null && pwd -P)" || sensitive=""
case "$(pwd -P)/" in
  "${sensitive:-/nonexistent}"/*) broad="" ;;
esac
# nono logs to stderr by default, where its proxy's warnings land on top
# of a harness's full-screen display. So we log to the dossier, where no
# agent can change or erase it, keeping one old log once it passes 1 MB.
# --log-file, not NONO_LOG_FILE, so the sandboxed command doesn't
# inherit a path it can't write. If you set NONO_LOG_FILE, nono uses it.
log=""
if [ -z "${NONO_LOG_FILE:-}" ]; then
  log="$dossier/logs/nono.log"
  if [ -f "$log" ] && [ "$(wc -c < "$log")" -gt 1000000 ]; then
    mv -f "$log" "$log.1"
  fi
fi
# The inbox holds files you give the agent (it can't change them); the
# outbox, files the agent gives you (it can't read them back).
export BULKHEAD_INBOX="$dossier/inbox" BULKHEAD_OUTBOX="$dossier/outbox"
# shellcheck disable=SC2086 # $compartment_opts and $open_opts split on purpose.
set -- $compartment_opts \
  nono run --profile "$profile" --allow-cwd ${broad:+--extends "$broad"} \
  ${log:+--log-file "$log"} --read "$BULKHEAD_INBOX" --write "$BULKHEAD_OUTBOX" \
  $open_opts "$@"

# We don't exec, so we can check the workspace when the session ends. A
# trap (unlike ignoring a signal) doesn't pass on to the harness, so
# Ctrl-C still reaches it, but doesn't stop us.
[ -z "$note_model" ] || engine_note "$note_model"
trap : INT QUIT
status=0
anon-access "$@" || status=$?
trap - INT QUIT
# A blank line sets our report apart from the session's last output.
echo >&2
check_workspace true || :
# Another session may still be running here, so remind you how to check
# again later.
echo "compart: run 'compart check' here any time (e.g., before you run git) to check for risky changes." >&2
exit "$status"
