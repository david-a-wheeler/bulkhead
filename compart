#!/bin/sh
# compart: run an AI harness in this workspace's compartment (see
# compartments.md) under nono, e.g., "compart claude" or
# "compart pi --print 'Say hello'". Each harness below adds only what it
# alone needs: its nono profile, any setup before it starts, and any
# extra nono options. So adding a harness (e.g., goose) means adding one
# case here. Then, for every harness, we add the workspace's nono
# options (from its dossier; see bulkhead-workspace), and run it all
# through anon-access, which strips secrets and starts the compartment.
#
# "compart sh [COMMAND [ARGUMENTS...]]" runs COMMAND (or, with none,
# your $SHELL) in the workspace's compartment, under the same shared
# policy as any harness, e.g., to see what an agent sees, or to run a
# tool you don't trust.
#
# "compart check" isn't a harness: it checks the workspace the way a
# launch would (its dossier, port lists, and git settings), plus a few
# things about the VM, and starts nothing. Run it before you run git in
# a workspace after a session you didn't watch.
#
# The sandbox policy every harness shares (files and network) is nono's
# "default" profile, nono-default-profile.json here, which vm-setup.sh
# installs and every nono pack extends. Outside ~/sensitive, anon-access
# also adds bulkhead-broad (GET and HEAD to the whole web). For one more
# host for one run, set NONO_ALLOW_DOMAIN (one host), e.g.,
# NONO_ALLOW_DOMAIN=docs.example.org compart claude; in broad mode that
# only matters under ~/sensitive, since bulkhead-broad's GET-only rules
# still apply to it. vm-setup.sh installs this.

set -eu

LIB_DIR=/usr/local/libexec/bulkhead

usage() {
  echo "Usage: compart HARNESS [ARGUMENTS...], where HARNESS is claude or pi; compart sh [COMMAND...]; or compart check"
}

die() {
  echo "compart: $*" >&2
  exit 1
}

# refuse_real_login FILE: stop if the Claude credentials FILE holds a
# real refresh token (anything but nono's phantoms, nono_...), which
# agents could read (see compartments.md, "Claude's login").
refuse_real_login() {
  [ -f "$1" ] || return 0
  refresh="$(jq -r '.claudeAiOauth.refreshToken // empty' "$1" 2> /dev/null)" ||
    die "can't read $1; delete it, then log in again with /login."
  case "$refresh" in
    '' | nono_*) ;;
    *) die "$1 holds a real Claude login, which agents could read. Delete it, revoke that login in your Claude account's settings, then run compart claude and, if it asks, log in again with /login (see compartments.md, \"Claude's login\")." ;;
  esac
}

[ $# -gt 0 ] || { usage >&2; exit 2; }
harness="$1"
shift
# VM ports to forward into the compartment (see bulkhead-compartment).
forward=""
check=false
case "$harness" in
  sh)
    # bulkhead-sh (nono-sh-profile.json) is nono's own linux-host-compat
    # plus what the harness packs add for the tools agents run
    # (runtimes, git's config), with a writable workspace. Unlike any
    # harness, it may read bash's startup files (e.g., ~/.bashrc), so
    # your shell works as usual; no sandbox can write them. So never
    # put secrets in them. nono denies writing ~/.bash_history, so we
    # keep history in memory only.
    profile=bulkhead-sh
    HISTFILE=""
    export HISTFILE
    [ $# -gt 0 ] || set -- "${SHELL:-/bin/sh}"
    set -- -- "$@"
    ;;
  check)
    [ $# -eq 0 ] || { usage >&2; exit 2; }
    check=true
    ;;
  claude)
    # bulkhead-claude (nono-claude-profile.json) extends nolabs-ai/claude,
    # nono's own maintained profile for Claude Code, with only Claude
    # Code's own hosts, and puts Claude's temp files back in anon-access's
    # per-directory TMPDIR.
    #
    # Each compartment has its own ~/.claude, but they share one
    # credentials directory, so one login works everywhere and a token
    # refresh in one reaches the others. We point Claude there with
    # CLAUDE_SECURESTORAGE_CONFIG_DIR, in nono's environment, not the
    # profile's set_vars: unless nono itself has that variable, it sets
    # it to "" for Claude (for macOS's Keychain; see nono's
    # docs/cli/clients/claude.mdx), overriding set_vars, and then Claude
    # keeps its login in ~/.claude, i.e., in each compartment. The
    # directory must exist before nono starts, or nono drops the grant.
    #
    # The file there must hold only nono's phantom tokens: when you log
    # in (/login) under nono, its oauth_capture (see
    # nono-claude-profile.json) keeps the real tokens in its own state,
    # which no sandbox can read, and gives Claude stand-ins that work
    # only through nono's proxy, and only for Anthropic's API. So an
    # agent can't take your login elsewhere. A real refresh token
    # (anything but nono_...) means a login from before this, or from
    # outside nono, which every agent could read; we refuse it. We also
    # refuse one in the compartment's own ~/.claude (below, once we know
    # the dossier), where Claude kept its login before we set
    # CLAUDE_SECURESTORAGE_CONFIG_DIR here.
    creds="$HOME/.local/state/bulkhead/claude-credentials"
    if [ ! -d "$creds" ]; then
      mkdir -p "$(dirname "$creds")"
      mkdir -m 700 "$creds"
    fi
    refuse_real_login "$creds/.credentials.json"
    CLAUDE_SECURESTORAGE_CONFIG_DIR="$creds"
    export CLAUDE_SECURESTORAGE_CONFIG_DIR
    profile=bulkhead-claude
    set -- -- claude "$@"
    ;;
  pi)
    # pi runs against the Mac's local AI models, which llama-swap serves
    # through this VM's SSH tunnel (see local-ai-plan.md), with no
    # automatic network activity of its own (no model catalog refresh,
    # version check, or telemetry). The API key comes from a file only
    # you can read, and reaches pi only through its environment.
    #
    # Each time, we ask the engine what it serves now (infer-models), and
    # write pi's list of models (~/.pi/agent/models.json, by
    # pi-models.jq) if that changed, keeping the old one as
    # models.json.bak. So a change on the Mac (see manage-models.sh
    # there) reaches pi the next time you start it. The default is the
    # one the Mac's list marks "default: true" (see ./manage-models.sh
    # default there); a later --model overrides it. If the engine doesn't
    # answer, pi uses the list it had. We also export infer-models'
    # answer in INFER_MODELS, with the key in INFER_API_KEY, for tools pi
    # runs that need them.
    #
    # vm-setup.sh installs pi where "npm install -g" would, and only on a
    # VM with the engine's API key.
    pi_dir=/usr/local/lib/node_modules/@earendil-works/pi-coding-agent
    key_file="$HOME/.config/bulkhead/infer-api-key"
    agent_dir="$HOME/.pi/agent"
    [ -x /usr/local/bin/pi ] && [ -s "$key_file" ] ||
      die "pi isn't set up on this VM (see vm-setup.sh's local AI section)."
    default=""
    if models="$(/usr/local/bin/infer-models)"; then
      mkdir -p "$agent_dir"
      new="$(mktemp "$agent_dir/models.json.XXXXXX")"
      printf '%s' "$models" | jq -f "$LIB_DIR/pi-models.jq" > "$new" ||
        { rm -f "$new"; exit 1; }
      if cmp -s "$new" "$agent_dir/models.json"; then
        rm -f "$new"
      else
        [ ! -f "$agent_dir/models.json" ] || cp "$agent_dir/models.json" "$agent_dir/models.json.bak"
        mv "$new" "$agent_dir/models.json"
      fi
      default="$(printf '%s' "$models" | jq -r '.default // empty')"
      [ -n "$default" ] ||
        echo "compart pi: WARNING: the engine has no default model (see ./manage-models.sh default on the Mac)." >&2
    else
      models=""
      echo "compart pi: WARNING: using pi's last list of models; INFER_MODELS is empty." >&2
    fi
    [ -z "$default" ] || set -- --model "$default" "$@"

    INFER_API_KEY="$(cat "$key_file")"
    INFER_MODELS="$models"
    PI_OFFLINE=1
    PI_SKIP_VERSION_CHECK=1
    PI_TELEMETRY=0
    export INFER_API_KEY INFER_MODELS PI_OFFLINE PI_SKIP_VERSION_CHECK PI_TELEMETRY

    # The shared network allowlist has no model providers: pi only needs
    # the engine's port on 127.0.0.1, where the tunnel ends.
    url="$(/usr/local/bin/infer-models --url)"
    port="${url#http://127.0.0.1:}"
    port="${port%%/*}"
    profile=nolabs-ai/pi
    # The engine is a VM service, so it must reach the compartment too.
    forward="$port"
    set -- --read "$pi_dir" --open-port "$port" -- /usr/local/bin/pi --provider mac-local "$@"
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "compart: unknown harness: $harness" >&2
    usage >&2
    exit 2
    ;;
esac

# Each line of a policy file is a port number, except blank lines and
# those starting with "#". A bad line stops the launch.
ports() {
  [ -f "$1" ] || return 0
  while IFS= read -r p || [ -n "$p" ]; do
    case "$p" in
      '' | '#'*) continue ;;
      *[!0-9]* | 0*) die "$1: not a port number: $p" ;;
    esac
    [ "$p" -le 65535 ] || die "$1: not a port number (1-65535): $p"
    echo "$p"
  done < "$1"
}

# We prepend each option, so the command line ends with the harness's
# own options and command. Ports are only digits (ports checks), so
# splitting $local_ports and $expose_ports is safe.
dossier="$("$(dirname "$0")/bulkhead-workspace" prepare)" || exit 1
local_ports="$(ports "$dossier/policy/local-ports")" || exit 1
expose_ports="$(ports "$dossier/policy/expose-ports")" || exit 1
# Claude's ~/.claude, as the agent will see it: the compartment's private
# copy (named as bulkhead-compartment names it), or, with
# BULKHEAD_NO_COMPARTMENT, your own.
if [ "$harness" = claude ]; then
  if [ -n "${BULKHEAD_NO_COMPARTMENT:-}" ]; then
    refuse_real_login "$HOME/.claude/.credentials.json"
  else
    refuse_real_login "$dossier/state/$(printf '%s' "${HOME#/}/.claude" | tr '/' '%')/.credentials.json"
  fi
fi
# An agent can plant git settings that run commands when you next run
# git here, so we show you any change since you last approved them
# (see bulkhead-git-check), before the session and again after it.
"$(dirname "$0")/bulkhead-git-check" || exit 1
if "$check"; then
  ok=true
  # vm-setup.sh's git pins (see make-git-safety-env) reach you only
  # after a new login.
  if [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/50-bulkhead-git-safety.conf" ]; then
    echo "compart check: WARNING: git's safety settings aren't installed; run vm-setup.sh." >&2
    ok=false
  elif [ -z "${GIT_CONFIG_COUNT:-}" ]; then
    echo "compart check: WARNING: git's safety settings aren't in your environment; log in again." >&2
    ok=false
  fi
  orphans="$("$(dirname "$0")/bulkhead-workspace" orphans)"
  if [ -n "$orphans" ]; then
    printf 'compart check: WARNING: these dossiers'"'"' workspaces are gone (see compartments.md, "Moving a workspace"):\n%s\n' "$orphans" >&2
    ok=false
  fi
  "$ok" || exit 1
  echo "compart check: $(pwd -P) looks as expected." >&2
  exit 0
fi
# The workspace's local ports (and exposed ones, which its agents use
# too) are on the compartment's own loopback, but nono still refuses
# any port not opened.
for p in $local_ports $expose_ports; do
  set -- --open-port "$p" "$@"
done
# The inbox holds files you give the agent (it can't change them); the
# outbox, files the agent gives you (it can't read them back).
export BULKHEAD_INBOX="$dossier/inbox" BULKHEAD_OUTBOX="$dossier/outbox"
set -- --read "$BULKHEAD_INBOX" --write "$BULKHEAD_OUTBOX" "$@"
# nono logs to stderr by default, and its proxy's warnings (e.g., "WARN
# tls_intercept ...") then land on top of a harness's full-screen
# display. So we log to the dossier's logs, outside every sandbox grant,
# so the agent can't change or erase its own log. We pass --log-file
# rather than export NONO_LOG_FILE, so the sandboxed command doesn't
# inherit a path it can't write. If you set NONO_LOG_FILE, nono uses
# that instead. We keep one old log, rotated at launch once it passes
# 1 MB.
if [ -z "${NONO_LOG_FILE:-}" ]; then
  log="$dossier/logs/nono.log"
  if [ -f "$log" ] && [ "$(wc -c < "$log")" -gt 1000000 ]; then
    mv -f "$log" "$log.1"
  fi
  set -- --log-file "$log" "$@"
fi
# Most work isn't sensitive, so by default we add the bulkhead-broad
# profile (GET and HEAD to the whole web; see agent-network-plan.md).
# Under ~/sensitive (by real path) we don't, so only the narrow
# allowlist in nono's "default" profile applies.
sensitive="$(cd "$HOME/sensitive" 2> /dev/null && pwd -P)" || sensitive=""
case "$(pwd -P)/" in
  "${sensitive:-/nonexistent}"/*) ;;
  *) set -- --extends bulkhead-broad "$@" ;;
esac
set -- nono run --profile "$profile" --allow-cwd "$@"
for p in $expose_ports; do
  set -- --expose-port "$p" "$@"
done
for p in $forward; do
  set -- --forward-port "$p" "$@"
done
# We don't exec, so we can check git's settings when the session ends.
# A trap (unlike ignoring a signal) doesn't pass on to the harness, so
# Ctrl-C still reaches it, but doesn't stop us.
trap : INT QUIT
status=0
anon-access "$@" || status=$?
trap - INT QUIT
"$(dirname "$0")/bulkhead-git-check" --after || :
exit "$status"
