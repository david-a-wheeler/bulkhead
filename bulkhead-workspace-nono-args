#!/bin/sh
# bulkhead-workspace-nono-args: print, one per line, the arguments
# anon-access adds to every "nono run" for the current directory's
# workspace (see workspace-dossier-plan.md):
#
#   --read DOSSIER/inbox     files you give the agent; it can't change them
#   --write DOSSIER/outbox   files the agent gives you; it can't read them
#   --open-port PORT         for each port in DOSSIER/policy/local-ports
#
# We don't pass --isolate net,loopback: nono can't make a network
# namespace inside bulkhead-compartment's bwrap (Ubuntu's AppArmor
# profile for bwrap denies it the capability), so bulkhead-compartment
# makes one with pasta instead. The agent's local ports are on that
# namespace's own loopback; nono still refuses any port not listed.
#
# Usage: bulkhead-workspace-nono-args [NONO-RUN-ARG...]
# Run it outside the sandbox (anon-access does). We ignore the
# arguments; anon-access passes the rest of the "nono run" command line.
set -eu

info="$(dirname "$0")/bulkhead-compartment-info"
dossier="$("$info" dossier)"
ports_file="$dossier/policy/local-ports"

printf '%s\n' --read "$dossier/inbox" --write "$dossier/outbox"

if [ -f "$ports_file" ]; then
  while IFS= read -r line; do
    line="${line%%#*}"
    # Trim blanks.
    line="$(printf '%s' "$line" | tr -d ' \t')"
    [ -n "$line" ] || continue
    case "$line" in
      *[!0-9-]* | -* | *- | *-*-*)
        echo "bulkhead: $ports_file: not a port or range: $line" >&2
        exit 1
        ;;
      *-*) first="${line%-*}" last="${line#*-}" ;;
      *) first="$line" last="$line" ;;
    esac
    if [ "$first" -lt 1 ] || [ "$last" -gt 65535 ] || [ "$first" -gt "$last" ]; then
      echo "bulkhead: $ports_file: not a port or range (1-65535): $line" >&2
      exit 1
    fi
    port="$first"
    while [ "$port" -le "$last" ]; do
      printf '%s\n' --open-port "$port"
      port=$((port + 1))
    done
  done < "$ports_file"
fi
